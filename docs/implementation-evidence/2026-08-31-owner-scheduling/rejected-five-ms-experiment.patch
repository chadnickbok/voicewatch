+static void test_slow_packet_work_yields_without_losing_ownership(void)
+{
+    esp_moq_ngtcp2_t a; int fd[2]; size_t accepted; uint64_t id; uint8_t byte=42;
+    datagram_pair(fd); init_adapter(&a,fd[0]);
+    for(unsigned i=0;i<8;++i) {
+        assert(transport_open_uni(&a,&id)==ESP_MOQ_OK);
+        assert(transport_write(&a,id,&byte,1,&accepted)==ESP_MOQ_OK && accepted==1);
+        assert(transport_finish(&a,id)==ESP_MOQ_OK);
+    }
+    write_cost_us=3000;
+    assert(pump_output(&a)==ESP_MOQ_OK);
+    assert(writes==2 && sent==2 && opens==8);
+    // Yielding keeps unsent work and ACK-owned bytes. Each new pump progresses
+    // another bounded batch; none of these payloads have been acknowledged.
+    for(unsigned i=0;i<8;++i) {
+        tx_stream_t *s=find_tx_stream(&a,2+4*i);
+        assert(s && s->head!=ESP_MOQ_NGTCP2_NO_INDEX && a.tx_blocks[s->head].data[0]==42);
+    }
+    for(unsigned i=0;i<3;++i) assert(pump_output(&a)==ESP_MOQ_OK);
+    assert(writes==8 && sent==8);
+    for(unsigned i=0;i<8;++i) assert(find_tx_stream(&a,2+4*i)->fin_submitted);
+    write_cost_us=0;
+    read_cost_us=3000; pending_receives=8;
+    assert(receive_packets(&a)==ESP_MOQ_OK && reads==2 && pending_receives==6);
+    for(unsigned i=0;i<3;++i) assert(receive_packets(&a)==ESP_MOQ_OK);
+    assert(reads==8 && pending_receives==0 && delivered==8);
+    read_cost_us=0; close(fd[0]); close(fd[1]);
 }
 
