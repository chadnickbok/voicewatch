{
  "schema_version": 1,
  "app_id": "calculator",
  "screen": {
    "id": "calculator",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "calculator.result",
          "type": "text",
          "props": {
            "text": "0",
            "style": "numeral",
            "max_lines": 1,
            "align": "end"
          },
          "semantics": {
            "label": "Result",
            "value": "0"
          }
        },
        {
          "id": "calculator.keys",
          "type": "keypad",
          "props": {
            "columns": 4,
            "keys": [
              "C", "+/-", "%", "/",
              "7", "8", "9", "*",
              "4", "5", "6", "-",
              "1", "2", "3", "+",
              "0", ".", "<-", "="
            ]
          },
          "events": {
            "tap": "key_pressed"
          },
          "semantics": {
            "label": "Calculator keypad"
          }
        }
      ]
    }
  }
}
