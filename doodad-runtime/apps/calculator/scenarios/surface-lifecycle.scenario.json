{
  "schema_version": 1,
  "id": "calculator.surface.lifecycle",
  "app_id": "dev.doodad.calculator",
  "initial_state": {
    "wall_time_ms": 1700000000000,
    "timezone_offset_minutes": -420,
    "app_state": "foreground",
    "display_state": "awake",
    "connectivity": "online"
  },
  "steps": [
    {
      "op": "surface.publish",
