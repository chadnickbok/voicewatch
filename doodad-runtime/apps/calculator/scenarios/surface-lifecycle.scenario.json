            "summary": "42",
            "state": {
              "provider": "mock",
              "interactive": true,
              "freshness": "current"
            }
          },
          "voice": {
            "revision": 3,
            "actions": [
              {
                "id": "calculator.primary",
                "example": "Calculate",
                "confirmation": "never"
              }
            ]
          }
        }
      }
    },
    {
      "op": "action.dispatch",
      "target": "calculator.primary",
      "value": {
        "source": "voice"
      }
    },
    {
      "op": "assert.state",
      "equals": {
        "surfaces.dev.doodad.calculator.domain_revision": 3,
        "surfaces.dev.doodad.calculator.freshness": "current",
        "providers.mock.revision": 2,
