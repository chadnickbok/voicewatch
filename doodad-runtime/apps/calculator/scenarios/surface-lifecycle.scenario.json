        "app_id": "dev.doodad.calculator",
        "domain_revision": 1,
        "observed_at_ms": 0,
        "freshness": "current",
        "declared_surfaces": [
          "app",
          "voice"
        ],
        "surfaces": {
          "app": {
            "revision": 1,
            "screen_id": "calculator.home",
            "title": "Calculator",
            "summary": "42",
            "state": {
              "provider": "mock",
              "interactive": true
            }
          },
          "voice": {
            "revision": 1,
            "actions": [
              {
                "id": "calculator.primary",
                "example": "Calculate",
                "confirmation": "never"
              }
            ]
          }
        }
      }
    },
    {
      "op": "clock.advance",
      "milliseconds": 1000
    },
    {
      "op": "provider.emit",
      "provider": "mock",
      "event": "calculator.stale",
      "revision": 1,
      "status": "stale",
      "payload": {
        "age_minutes": 18
      }
    },
    {
      "op": "surface.publish",
      "snapshot": {
        "schema_version": 1,
        "app_id": "dev.doodad.calculator",
        "domain_revision": 2,
        "observed_at_ms": 1000,
        "freshness": "stale",
        "declared_surfaces": [
          "app",
          "voice"
        ],
        "surfaces": {
          "app": {
            "revision": 2,
            "screen_id": "calculator.home",
            "title": "Calculator",
            "summary": "42",
            "state": {
              "provider": "mock",
              "interactive": true,
              "freshness": "stale"
            }
          },
          "voice": {
            "revision": 2,
            "actions": [
              {
                "id": "calculator.primary",
                "example": "Calculate",
                "confirmation": "never"
              }
            ]
          }
        }
      }
    },
    {
      "op": "lifecycle.set",
      "connectivity": "offline"
