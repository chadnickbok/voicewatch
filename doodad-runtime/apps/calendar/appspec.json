{
  "schema_version": 1,
  "app_id": "calendar",
  "screen": {
    "id": "calendar.agenda",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "calendar.agenda.stack",
          "type": "scroll",
          "props": {
            "gap": "none",
            "align": "stretch",
            "children": [
              {
                "id": "calendar.agenda.content",
                "type": "column",
                "props": {
                  "gap": "none",
                  "align": "stretch",
                  "children": [
                    {
                      "id": "calendar.agenda.heading",
                      "type": "text",
                      "props": {
                        "text": "THU 30  /  TODAY",
                        "style": "label",
                        "max_lines": 1,
                        "align": "center"
                      },
                      "semantics": {
                        "label": "Today, Thursday the 30th"
                      }
                    },
                    {
                      "id": "calendar.agenda.standup",
                      "type": "card",
                      "props": {
                        "title": "11:00  Stand-up",
                        "body": "Studio A  /  25 min",
                        "tone": "neutral"
                      },
                      "semantics": {
                        "label": "Stand-up at 11"
                      }
                    },
                    {
                      "id": "calendar.agenda.review",
                      "type": "card",
                      "props": {
                        "title": "2:00  Design review",
                        "body": "Studio  /  4 guests",
                        "tone": "primary"
                      },
                      "events": {
                        "tap": "calendar.open.detail"
                      },
                      "semantics": {
                        "label": "Open Design review at 2"
                      }
                    },
                    {
                      "id": "calendar.agenda.travel",
                      "type": "button",
                      "props": {
                        "label": "Travel view",
                        "tone": "neutral",
                        "variant": "tonal",
                        "size": "default"
                      },
                      "events": {
                        "tap": "calendar.travel"
                      },
                      "semantics": {
                        "label": "Show travel time zone"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
