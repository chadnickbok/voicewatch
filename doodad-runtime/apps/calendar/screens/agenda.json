{
  "schema_version": 1,
  "app_id": "calendar",
  "screen": {
    "id": "calendar.agenda",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "calendar.agenda.heading",
          "type": "text",
          "props": {
            "text": "TODAY",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "calendar.agenda.summary",
          "type": "text",
          "props": {
            "text": "2 events",
            "style": "numeral",
            "max_lines": 2,
            "align": "center"
          },
          "semantics": {
            "label": "TODAY",
            "value": "2 events"
          }
        },
        {
          "id": "calendar.agenda.detail",
          "type": "card",
          "props": {
            "title": "Deterministic fixture",
            "body": "11:00 Stand-up\n2:00 Design review",
            "tone": "neutral"
          }
        },
        {
          "id": "calendar.agenda.primary",
          "type": "button",
          "props": {
            "label": "Open event",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "calendar.open.detail"
          },
          "semantics": {
            "label": "Open event"
          }
        },
        {
          "id": "calendar.agenda.secondary",
          "type": "button",
          "props": {
            "label": "Travel mode",
            "tone": "neutral",
            "variant": "outlined",
            "size": "default"
          },
          "events": {
            "tap": "calendar.travel"
          },
          "semantics": {
            "label": "Travel mode"
          }
        }
      ]
    }
  }
}
