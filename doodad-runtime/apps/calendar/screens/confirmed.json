{
  "schema_version": 1,
  "app_id": "calendar",
  "screen": {
    "id": "calendar.confirmed",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "calendar.confirmed.stack",
          "type": "scroll",
          "props": {
            "gap": "none",
            "align": "stretch",
            "children": [
              {
                "id": "calendar.confirmed.content",
                "type": "column",
                "props": {
                  "gap": "none",
                  "align": "stretch",
                  "children": [
                    {
                      "id": "calendar.confirmed.heading",
                      "type": "text",
                      "props": {
                        "text": "RSVP  /  SYNCED",
                        "style": "label",
                        "max_lines": 1,
                        "align": "center"
                      }
                    },
                    {
                      "id": "calendar.confirmed.event",
                      "type": "card",
                      "props": {
                        "title": "You're going",
                        "body": "Design review  /  2:00\nSaved for offline use",
                        "tone": "primary"
                      },
                      "semantics": {
                        "label": "RSVP recorded",
                        "value": "Going"
                      }
                    },
                    {
                      "id": "calendar.confirmed.travel",
                      "type": "button",
                      "props": {
                        "label": "Travel view",
                        "tone": "primary",
                        "variant": "filled",
                        "size": "default"
                      },
                      "events": {
                        "tap": "calendar.travel"
                      },
                      "semantics": {
                        "label": "Travel view"
                      }
                    },
                    {
                      "id": "calendar.confirmed.back",
                      "type": "button",
                      "props": {
                        "label": "Agenda",
                        "tone": "neutral",
                        "variant": "tonal",
                        "size": "default"
                      },
                      "events": {
                        "tap": "calendar.back"
                      },
                      "semantics": {
                        "label": "Agenda"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
