{
  "schema_version": 1,
  "app_id": "calendar",
  "screen": {
    "id": "calendar.confirmed",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "calendar.confirmed.heading",
          "type": "text",
          "props": {
            "text": "RSVP RECORDED",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "calendar.confirmed.summary",
          "type": "text",
          "props": {
            "text": "Going ✓",
            "style": "numeral",
            "max_lines": 2,
            "align": "center"
          },
          "semantics": {
            "label": "RSVP RECORDED",
            "value": "Going ✓"
          }
        },
        {
          "id": "calendar.confirmed.detail",
          "type": "card",
          "props": {
            "title": "Deterministic fixture",
            "body": "Queued offline · revision 4",
            "tone": "neutral"
          }
        },
        {
          "id": "calendar.confirmed.primary",
          "type": "button",
          "props": {
            "label": "Simulate travel",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "calendar.travel"
          },
          "semantics": {
            "label": "Simulate travel"
          }
        },
        {
          "id": "calendar.confirmed.secondary",
          "type": "button",
          "props": {
            "label": "Agenda",
            "tone": "neutral",
            "variant": "outlined",
            "size": "default"
          },
          "events": {
            "tap": "calendar.back"
          },
          "semantics": {
            "label": "Agenda"
          }
        }
      ]
    }
  }
}
