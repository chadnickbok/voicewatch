{
  "schema_version": 1,
  "app_id": "calendar",
  "screen": {
    "id": "calendar.detail",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "calendar.detail.stack",
          "type": "scroll",
          "props": {
            "gap": "none",
            "align": "stretch",
            "children": [
              {
                "id": "calendar.detail.content",
                "type": "column",
                "props": {
                  "gap": "none",
                  "align": "stretch",
                  "children": [
                    {
                      "id": "calendar.detail.heading",
                      "type": "text",
                      "props": {
                        "text": "DESIGN REVIEW",
                        "style": "label",
                        "max_lines": 1,
                        "align": "center"
                      }
                    },
                    {
                      "id": "calendar.detail.event",
                      "type": "card",
                      "props": {
                        "title": "2:00 - 2:45",
                        "body": "Studio  /  4 guests\nProduct design review",
                        "tone": "primary"
                      },
                      "semantics": {
                        "label": "Design review details",
                        "value": "2 to 2:45, Studio, 4 guests"
                      }
                    },
                    {
                      "id": "calendar.detail.rsvp",
                      "type": "button",
                      "props": {
                        "label": "I'm going",
                        "tone": "primary",
                        "variant": "filled",
                        "size": "default"
                      },
                      "events": {
                        "tap": "calendar.rsvp.yes"
                      },
                      "semantics": {
                        "label": "Accept invitation"
                      }
                    },
                    {
                      "id": "calendar.detail.back",
                      "type": "button",
                      "props": {
                        "label": "Agenda",
                        "tone": "neutral",
                        "variant": "tonal",
                        "size": "default"
                      },
                      "events": {
                        "tap": "calendar.back"
                      },
                      "semantics": {
                        "label": "Back to agenda"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
