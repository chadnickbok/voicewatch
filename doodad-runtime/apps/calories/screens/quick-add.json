{
  "schema_version": 1,
  "app_id": "calories",
  "screen": {
    "id": "calories.quick-add",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "calories.quick.heading",
          "type": "text",
          "props": {
            "text": "QUICK ADD",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "calories.quick.amount",
          "type": "stepper",
          "props": {
            "label": "Calories",
            "value": 100,
            "unit": "kcal",
            "minimum": 50,
            "maximum": 1000,
            "step": 50
          },
          "events": {
            "valueCommitted": "calories.amount.changed"
          },
          "semantics": {
            "label": "Calories to add",
            "value": "100 kilocalories"
          }
        },
        {
          "id": "calories.quick.detail",
          "type": "card",
          "props": {
            "title": "TODAY / 1,420 KCAL",
            "body": "Saved locally with daily total",
            "tone": "neutral"
          }
        },
        {
          "id": "calories.quick.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "calories.quick.add",
                "type": "button",
                "props": {
                  "label": "Add",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "calories.add"
                },
                "semantics": {
                  "label": "Add calories"
                }
              },
              {
                "id": "calories.quick.voice",
                "type": "button",
                "props": {
                  "label": "Voice",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "calories.voice"
                },
                "semantics": {
                  "label": "Review a structured voice record"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
