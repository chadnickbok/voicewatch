{
  "schema_version": 1,
  "app_id": "calories",
  "screen": {
    "id": "calories.voice-review",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "calories.review.heading",
          "type": "text",
          "props": {
            "text": "VOICE RESULT",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "calories.review.summary",
          "type": "text",
          "props": {
            "text": "650 kcal",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "calories.review.detail",
          "type": "card",
          "props": {
            "title": "LUNCH  /  45G PROTEIN",
            "body": "Chicken bowl  /  ready to save",
            "tone": "neutral"
          }
        },
        {
          "id": "calories.review.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "calories.review.confirm",
                "type": "button",
                "props": {
                  "label": "Save",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "calories.confirm.voice"
                },
                "semantics": {
                  "label": "Confirm voice nutrition record"
                }
              },
              {
                "id": "calories.review.correct",
                "type": "button",
                "props": {
                  "label": "Edit",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "calories.correct"
                },
                "semantics": {
                  "label": "Correct voice nutrition record"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
