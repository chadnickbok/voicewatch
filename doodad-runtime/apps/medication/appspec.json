{
  "schema_version": 1,
  "app_id": "medication",
  "screen": {
    "id": "medication.home",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "medication.due.label",
          "type": "text",
          "props": {
            "text": "DUE / 9:00",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "medication.summary",
          "type": "text",
          "props": {
            "text": "VITAMIN D",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Medication due",
            "value": "Vitamin D at 9"
          }
        },
        {
          "id": "medication.dose",
          "type": "live_card",
          "props": {
            "title": "1 TABLET / 1000 IU",
            "body": "Due now / on watch",
            "tone": "primary"
          }
        },
        {
          "id": "medication.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "medication.primary",
                "type": "button",
                "props": {
                  "label": "Taken",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "medication.primary"
                },
                "semantics": {
                  "label": "Log Vitamin D as taken"
                }
              },
              {
                "id": "medication.snooze",
                "type": "button",
                "props": {
                  "label": "10 min",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "medication.snooze"
                },
                "semantics": {
                  "label": "Remind me in ten minutes"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
