{
  "schema_version": 1,
  "app_id": "medication",
  "screen": {
    "id": "medication.editor",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "medication.editor.heading",
          "type": "text",
          "props": {
            "text": "REMINDER",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "medication.editor.summary",
          "type": "text",
          "props": {
            "text": "8:00",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Reminder time",
            "value": "8:00 daily"
          }
        },
        {
          "id": "medication.editor.detail",
          "type": "live_card",
          "props": {
            "title": "DAILY / EVERY DAY",
            "body": "Private / follow-up on",
            "progress": 1.0,
            "tone": "primary"
          }
        },
        {
          "id": "medication.editor.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "medication.editor.primary",
                "type": "button",
                "props": {
                  "label": "Save",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "medication.save"
                },
                "semantics": {
                  "label": "Save reminder"
                }
              },
              {
                "id": "medication.editor.secondary",
                "type": "button",
                "props": {
                  "label": "Cancel",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "medication.cancel"
                },
                "semantics": {
                  "label": "Cancel reminder changes"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
