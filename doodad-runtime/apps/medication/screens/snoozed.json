{
  "schema_version": 1,
  "app_id": "medication",
  "screen": {
    "id": "medication.snoozed",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "medication.snoozed.heading",
          "type": "text",
          "props": {
            "text": "REMIND / 9:12",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "medication.snoozed.summary",
          "type": "text",
          "props": {
            "text": "10 MIN",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Reminder snoozed",
            "value": "Due at 9:12"
          }
        },
        {
          "id": "medication.snoozed.detail",
          "type": "live_card",
          "props": {
            "title": "VITAMIN D / SNOOZED",
            "body": "Haptic armed / log safe",
            "progress": 0.5,
            "tone": "neutral"
          }
        },
        {
          "id": "medication.snoozed.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "medication.snoozed.primary",
                "type": "button",
                "props": {
                  "label": "Taken",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "medication.take"
                },
                "semantics": {
                  "label": "Log Vitamin D as taken"
                }
              },
              {
                "id": "medication.snoozed.secondary",
                "type": "button",
                "props": {
                  "label": "Edit",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "medication.schedule"
                },
                "semantics": {
                  "label": "Edit medication schedule"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
