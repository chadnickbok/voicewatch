{
  "schema_version": 1,
  "app_id": "medication",
  "screen": {
    "id": "medication.taken",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "medication.taken.heading",
          "type": "text",
          "props": {
            "text": "LOGGED / 9:02",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "medication.taken.summary",
          "type": "text",
          "props": {
            "text": "TAKEN",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Vitamin D status",
            "value": "Taken at 9:02"
          }
        },
        {
          "id": "medication.taken.detail",
          "type": "live_card",
          "props": {
            "title": "VITAMIN D / 1 TABLET",
            "body": "Today / 12 day streak",
            "progress": 1.0,
            "tone": "primary"
          }
        },
        {
          "id": "medication.taken.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "medication.taken.primary",
                "type": "button",
                "props": {
                  "label": "Edit",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "medication.add"
                },
                "semantics": {
                  "label": "Edit medication reminder"
                }
              },
              {
                "id": "medication.taken.secondary",
                "type": "button",
                "props": {
                  "label": "Undo",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "medication.undo"
                },
                "semantics": {
                  "label": "Undo medication log"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
