{
  "schema_version": 1,
  "app_id": "navigation",
  "screen": {
    "id": "navigation.home",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "navigation.home.context",
          "type": "text",
          "props": {
            "text": "WALK / MARKET",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "navigation.summary",
          "type": "text",
          "props": {
            "text": "8 MIN",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Estimated walking time",
            "value": "8 minutes"
          }
        },
        {
          "id": "navigation.home.detail",
          "type": "live_card",
          "props": {
            "title": "1.4 MI / ARRIVE 10:18",
            "body": "3 turns / route saved offline",
            "progress": 0.08,
            "tone": "primary"
          }
        },
        {
          "id": "navigation.home.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "navigation.primary",
                "type": "button",
                "props": {
                  "label": "Start",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.primary"
                },
                "semantics": {
                  "label": "Start walking directions"
                }
              },
              {
                "id": "navigation.home.overview",
                "type": "button",
                "props": {
                  "label": "Route",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.overview"
                },
                "semantics": {
                  "label": "View route overview"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
