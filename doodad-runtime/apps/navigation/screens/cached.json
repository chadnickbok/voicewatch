{
  "schema_version": 1,
  "app_id": "navigation",
  "screen": {
    "id": "navigation.cached",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "navigation.cached.heading",
          "type": "text",
          "props": {
            "text": "GPS UNAVAILABLE",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "navigation.cached.summary",
          "type": "text",
          "props": {
            "text": "Continue 0.3 mi",
            "style": "numeral",
            "max_lines": 2,
            "align": "center"
          },
          "semantics": {
            "label": "GPS UNAVAILABLE",
            "value": "Continue 0.3 mi"
          }
        },
        {
          "id": "navigation.cached.detail",
          "type": "card",
          "props": {
            "title": "Deterministic fixture",
            "body": "Using cached route + compass",
            "tone": "neutral"
          }
        },
        {
          "id": "navigation.cached.primary",
          "type": "button",
          "props": {
            "label": "Recover GPS",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "navigation.recover"
          },
          "semantics": {
            "label": "Recover GPS"
          }
        },
        {
          "id": "navigation.cached.secondary",
          "type": "button",
          "props": {
            "label": "Overview",
            "tone": "neutral",
            "variant": "outlined",
            "size": "default"
          },
          "events": {
            "tap": "navigation.overview"
          },
          "semantics": {
            "label": "Overview"
          }
        }
      ]
    }
  }
}
