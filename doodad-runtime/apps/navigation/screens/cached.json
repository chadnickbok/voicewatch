{
  "schema_version": 1,
  "app_id": "navigation",
  "screen": {
    "id": "navigation.cached",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "navigation.cached.context",
          "type": "text",
          "props": {
            "text": "GPS LOST / CACHE",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "navigation.cached.summary",
          "type": "text",
          "props": {
            "text": "0.3 MI",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Distance to continue on the cached route",
            "value": "0.3 miles"
          }
        },
        {
          "id": "navigation.cached.detail",
          "type": "live_card",
          "props": {
            "title": "CONTINUE / MARKET",
            "body": "Compass / route cached",
            "progress": 0.48,
            "tone": "primary"
          }
        },
        {
          "id": "navigation.cached.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "navigation.cached.primary",
                "type": "button",
                "props": {
                  "label": "Recover",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.recover"
                },
                "semantics": {
                  "label": "Recover GPS guidance"
                }
              },
              {
                "id": "navigation.cached.secondary",
                "type": "button",
                "props": {
                  "label": "Route",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.overview"
                },
                "semantics": {
                  "label": "View cached route overview"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
