{
  "schema_version": 1,
  "app_id": "navigation",
  "screen": {
    "id": "navigation.maneuver",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "navigation.maneuver.context",
          "type": "text",
          "props": {
            "text": "WALK / 8 MIN",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "navigation.maneuver.summary",
          "type": "text",
          "props": {
            "text": "200 FT",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Distance to the next turn",
            "value": "200 feet"
          }
        },
        {
          "id": "navigation.maneuver.detail",
          "type": "live_card",
          "props": {
            "title": "TURN RIGHT / MARKET",
            "body": "Then 3rd / haptic soon",
            "progress": 0.35,
            "tone": "primary"
          }
        },
        {
          "id": "navigation.maneuver.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "navigation.maneuver.primary",
                "type": "button",
                "props": {
                  "label": "GPS off",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.lose"
                },
                "semantics": {
                  "label": "Simulate losing GPS"
                }
              },
              {
                "id": "navigation.maneuver.secondary",
                "type": "button",
                "props": {
                  "label": "Route",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.overview"
                },
                "semantics": {
                  "label": "View route overview"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
