{
  "schema_version": 1,
  "app_id": "navigation",
  "screen": {
    "id": "navigation.overview",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "navigation.overview.context",
          "type": "text",
          "props": {
            "text": "ROUTE / NORTH-UP",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "navigation.overview.summary",
          "type": "text",
          "props": {
            "text": "1.4 MI",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Remaining route distance",
            "value": "1.4 miles"
          }
        },
        {
          "id": "navigation.overview.detail",
          "type": "live_card",
          "props": {
            "title": "ARRIVE 10:18 / 8 MIN",
            "body": "3 turns / route saved offline",
            "progress": 0.15,
            "tone": "primary"
          }
        },
        {
          "id": "navigation.overview.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "navigation.overview.primary",
                "type": "button",
                "props": {
                  "label": "Guide",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.continue"
                },
                "semantics": {
                  "label": "Continue turn-by-turn guidance"
                }
              },
              {
                "id": "navigation.overview.secondary",
                "type": "button",
                "props": {
                  "label": "GPS off",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.lose"
                },
                "semantics": {
                  "label": "Simulate losing GPS"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
