{
  "schema_version": 1,
  "app_id": "navigation",
  "screen": {
    "id": "navigation.recovered",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "navigation.recovered.context",
          "type": "text",
          "props": {
            "text": "GPS BACK / ROUTE",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "navigation.recovered.summary",
          "type": "text",
          "props": {
            "text": "120 FT",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Recovered distance to the next turn",
            "value": "120 feet"
          }
        },
        {
          "id": "navigation.recovered.detail",
          "type": "live_card",
          "props": {
            "title": "TURN RIGHT / MARKET",
            "body": "Progress kept / no jump",
            "progress": 0.42,
            "tone": "primary"
          }
        },
        {
          "id": "navigation.recovered.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "navigation.recovered.primary",
                "type": "button",
                "props": {
                  "label": "Next",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.next"
                },
                "semantics": {
                  "label": "Advance to the next turn fixture"
                }
              },
              {
                "id": "navigation.recovered.secondary",
                "type": "button",
                "props": {
                  "label": "Home",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "navigation.home"
                },
                "semantics": {
                  "label": "Return to the route preview"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
