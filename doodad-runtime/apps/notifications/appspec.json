{
  "schema_version": 1,
  "app_id": "notifications",
  "screen": {
    "id": "notifications.inbox",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "notifications.summary",
          "type": "text",
          "props": {
            "text": "2 unread",
            "style": "title",
            "max_lines": 1
          }
        },
        {
          "id": "notifications.maya",
          "type": "button",
          "props": {
            "label": "Maya · Dinner at 7?",
            "tone": "primary",
            "variant": "tonal",
            "size": "compact"
          },
          "events": {
            "tap": "notification.open.maya"
          },
          "semantics": {
            "label": "Open notification from Maya"
          }
        },
        {
          "id": "notifications.build",
          "type": "button",
          "props": {
            "label": "CI · Build finished",
            "tone": "neutral",
            "variant": "tonal",
            "size": "compact"
          },
          "events": {
            "tap": "notification.open.build"
          },
          "semantics": {
            "label": "Open build notification"
          }
        },
        {
          "id": "notifications.clear",
          "type": "button",
          "props": {
            "label": "Clear all",
            "tone": "neutral",
            "variant": "text",
            "size": "compact"
          },
          "events": {
            "tap": "notification.clear"
          },
          "semantics": {
            "label": "Clear all notifications"
          }
        }
      ]
    }
  }
}
