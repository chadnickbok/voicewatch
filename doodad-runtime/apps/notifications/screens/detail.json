{
  "schema_version": 1,
  "app_id": "notifications",
  "screen": {
    "id": "notifications.detail",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "notification.detail.stack",
          "type": "scroll",
          "props": {
            "gap": "sm",
            "align": "stretch",
            "children": [
              {
                "id": "notification.detail.heading",
                "type": "text",
                "props": {
                  "text": "Maya  NOW",
                  "style": "label",
                  "max_lines": 1,
                  "align": "center"
                }
              },
              {
                "id": "notification.detail.message",
                "type": "card",
                "props": {
                  "title": "Dinner at 7?",
                  "body": "Ramen near the hotel.",
                  "tone": "primary"
                }
              },
              {
                "id": "notification.detail.reply",
                "type": "button",
                "props": {
                  "label": "Reply",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "notification.reply"
                },
                "semantics": {
                  "label": "Reply to Maya"
                }
              },
              {
                "id": "notification.detail.dismiss",
                "type": "button",
                "props": {
                  "label": "Dismiss",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "notification.dismiss"
                },
                "semantics": {
                  "label": "Dismiss notification"
                }
              },
              {
                "id": "notification.detail.back",
                "type": "button",
                "props": {
                  "label": "Back",
                  "tone": "neutral",
                  "variant": "text",
                  "size": "default"
                },
                "events": {
                  "tap": "notification.back"
                },
                "semantics": {
                  "label": "Back to inbox"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
