{
  "schema_version": 1,
  "app_id": "notifications",
  "screen": {
    "id": "notifications.inbox",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "notifications.stack",
          "type": "scroll",
          "props": {
            "gap": "sm",
            "align": "stretch",
            "children": [
              {
                "id": "notifications.summary",
                "type": "text",
                "props": {
                  "text": "1 unread",
                  "style": "label",
                  "max_lines": 1,
                  "align": "center"
                }
              },
              {
                "id": "notifications.build",
                "type": "card",
                "props": {
                  "title": "Buildbot  4 MIN",
                  "body": "Release build passed.",
                  "tone": "neutral"
                },
                "events": {
                  "tap": "notification.open.build"
                },
                "semantics": {
                  "label": "Open build notification"
                }
              },
              {
                "id": "notifications.clear",
                "type": "button",
                "props": {
                  "label": "Clear all",
                  "tone": "neutral",
                  "variant": "text",
                  "size": "default"
                },
                "events": {
                  "tap": "notification.clear"
                },
                "semantics": {
                  "label": "Clear all notifications"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
