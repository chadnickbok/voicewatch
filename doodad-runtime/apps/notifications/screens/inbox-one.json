{
  "schema_version": 1,
  "app_id": "notifications",
  "screen": {
    "id": "notifications.inbox",
    "type": "screen",
    "props": {
      "gap": "md",
      "align": "stretch",
      "children": [
        {
          "id": "notifications.heading",
          "type": "text",
          "props": {
            "text": "INBOX",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "notifications.summary",
          "type": "text",
          "props": {
            "text": "1 unread",
            "style": "title",
            "max_lines": 1
          }
        },
        {
          "id": "notifications.build",
          "type": "button",
          "props": {
            "label": "CI · Build finished",
            "tone": "neutral",
            "variant": "tonal",
            "size": "default"
          },
          "events": {
            "tap": "notification.open.build"
          },
          "semantics": {
            "label": "Open build notification"
          }
        },
        {
          "id": "notifications.clear",
          "type": "button",
          "props": {
            "label": "Clear all",
            "tone": "neutral",
            "variant": "text",
            "size": "compact"
          },
          "events": {
            "tap": "notification.clear"
          },
          "semantics": {
            "label": "Clear all notifications"
          }
        }
      ]
    }
  }
}
