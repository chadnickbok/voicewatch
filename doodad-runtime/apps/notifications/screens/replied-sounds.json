{
  "schema_version": 1,
  "app_id": "notifications",
  "screen": {
    "id": "notifications.replied",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "notification.replied.stack",
          "type": "scroll",
          "props": {
            "gap": "sm",
            "align": "stretch",
            "children": [
              {
                "id": "notification.replied.heading",
                "type": "text",
                "props": {
                  "text": "Sent to Maya",
                  "style": "label",
                  "max_lines": 1,
                  "align": "center"
                }
              },
              {
                "id": "notification.replied.message",
                "type": "card",
                "props": {
                  "title": "Great",
                  "body": "Delivered just now.",
                  "tone": "tertiary"
                }
              },
              {
                "id": "notification.replied.done",
                "type": "button",
                "props": {
                  "label": "Done",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "notification.reply.done"
                },
                "semantics": {
                  "label": "Return to inbox"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
