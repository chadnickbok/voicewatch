{
  "schema_version": 1,
  "app_id": "notifications",
  "screen": {
    "id": "notifications.replied",
    "type": "screen",
    "props": {
      "gap": "md",
      "align": "stretch",
      "children": [
        {
          "id": "notification.replied.heading",
          "type": "text",
          "props": {
            "text": "REPLY SENT",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "notification.replied.message",
          "type": "card",
          "props": {
            "title": "On my way",
            "body": "Delivered to Maya · exactly once",
            "tone": "tertiary"
          }
        },
        {
          "id": "notification.replied.done",
          "type": "button",
          "props": {
            "label": "Done",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "notification.reply.done"
          },
          "semantics": {
            "label": "Return to inbox"
          }
        }
      ]
    }
  }
}
