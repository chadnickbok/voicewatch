{
  "schema_version": 1,
  "app_id": "notifications",
  "screen": {
    "id": "notifications.reply",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "notification.reply.stack",
          "type": "scroll",
          "props": {
            "gap": "sm",
            "align": "stretch",
            "children": [
              {
                "id": "notification.reply.heading",
                "type": "text",
                "props": {
                  "text": "Reply to Maya",
                  "style": "label",
                  "max_lines": 1,
                  "align": "center"
                }
              },
              {
                "id": "notification.reply.message",
                "type": "card",
                "props": {
                  "title": "Dinner at 7?",
                  "body": "Ramen near the hotel.",
                  "tone": "neutral"
                }
              },
              {
                "id": "notification.reply.one",
                "type": "button",
                "props": {
                  "label": "Coming",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "notification.reply.on_my_way"
                },
                "semantics": {
                  "label": "Reply On my way"
                }
              },
              {
                "id": "notification.reply.two",
                "type": "button",
                "props": {
                  "label": "Great",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "notification.reply.sounds_good"
                },
                "semantics": {
                  "label": "Reply Sounds good"
                }
              },
              {
                "id": "notification.reply.back",
                "type": "button",
                "props": {
                  "label": "Back",
                  "tone": "neutral",
                  "variant": "text",
                  "size": "default"
                },
                "events": {
                  "tap": "notification.reply.back"
                },
                "semantics": {
                  "label": "Back to notification"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
