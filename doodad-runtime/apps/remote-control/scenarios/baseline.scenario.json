{
  "schema_version": 1,
  "id": "remote-control.baseline.interaction",
  "app_id": "dev.doodad.remote-control",
  "initial_state": {
    "wall_time_ms": 1700000000000,
    "timezone_offset_minutes": -420,
    "app_state": "foreground",
    "display_state": "awake",
    "connectivity": "online"
  },
  "steps": [
    {
      "op": "provider.emit",
      "provider": "mock",
      "event": "remote-control.loaded",
      "revision": 1,
      "status": "current",
      "payload": {
        "deterministic": true
      }
    },
    {
      "op": "surface.publish",
      "snapshot": {
        "schema_version": 1,
        "app_id": "dev.doodad.remote-control",
        "domain_revision": 1,
        "observed_at_ms": 0,
        "freshness": "current",
        "declared_surfaces": [
          "app",
          "glance",
          "voice"
        ],
        "surfaces": {
          "app": {
            "revision": 1,
            "screen_id": "remote-control.home",
            "title": "Remote Control Lab",
            "summary": "Phone connected",
            "state": {
              "provider": "mock",
              "interactive": true
            }
          },
          "glance": {
            "revision": 1,
            "template": "metric",
            "title": "Remote Control Lab",
            "primary": "Phone connected",
            "secondary": "Mock data · now",
            "action": {
              "id": "remote-control.primary",
              "label": "Trigger"
            }
          },
          "voice": {
            "revision": 1,
            "actions": [
              {
                "id": "remote-control.primary",
                "example": "Trigger",
                "confirmation": "never"
              }
            ]
          }
        }
      }
    },
    {
      "op": "action.dispatch",
      "target": "remote-control.primary",
      "value": {
        "source": "touch"
      }
    },
    {
      "op": "assert.state",
      "equals": {
        "providers.mock.revision": 1,
        "surfaces.dev.doodad.remote-control.domain_revision": 1,
        "actions.count": 1,
        "actions.last_target": "remote-control.primary"
      }
    }
  ]
}
