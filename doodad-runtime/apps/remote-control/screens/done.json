{
  "schema_version": 1,
  "app_id": "remote-control",
  "screen": {
    "id": "remote-control.done",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "remote-control.done.viewfinder",
          "type": "image",
          "props": {
            "asset": "777d468ea847318acd22e2eb79f108e75e2674448e8b53fa8fba0bc08fd7b522",
            "fit": "cover"
          },
          "semantics": {
            "label": "Captured desert camera preview"
          }
        },
        {
          "id": "remote-control.done.context",
          "type": "text",
          "props": {
            "text": "PHOTO SAVED",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "remote-control.done.summary",
          "type": "text",
          "props": {
            "text": "CAPTURED",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Camera result",
            "value": "CAPTURED"
          }
        },
        {
          "id": "remote-control.done.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "remote-control.done.primary",
                "type": "button",
                "props": {
                  "label": "Again",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "remote.camera"
                },
                "semantics": {
                  "label": "Take another photo"
                }
              },
              {
                "id": "remote-control.done.secondary",
                "type": "button",
                "props": {
                  "label": "Controls",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "remote.targets"
                },
                "semantics": {
                  "label": "Return to camera controls"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
