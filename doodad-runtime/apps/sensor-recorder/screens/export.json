{
  "schema_version": 1,
  "app_id": "sensor-recorder",
  "screen": {
    "id": "sensor-recorder.export",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "sensor-recorder.export.heading",
          "type": "text",
          "props": {
            "text": "SESSION / DONE",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "sensor-recorder.export.summary",
          "type": "text",
          "props": {
            "text": "1024",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Sensor session sample count",
            "value": "1024 samples"
          }
        },
        {
          "id": "sensor-recorder.export.detail",
          "type": "live_card",
          "props": {
            "title": "48 KIB / CHECKSUM OK",
            "body": "20 seconds / ready to export",
            "progress": 1.0,
            "tone": "primary"
          }
        },
        {
          "id": "sensor-recorder.export.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "sensor-recorder.export.primary",
                "type": "button",
                "props": {
                  "label": "Export",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "sensor.export.csv"
                },
                "semantics": {
                  "label": "Export sensor session as CSV"
                }
              },
              {
                "id": "sensor-recorder.export.secondary",
                "type": "button",
                "props": {
                  "label": "Again",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "sensor.again"
                },
                "semantics": {
                  "label": "Record another sensor session"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
