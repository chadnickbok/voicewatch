{
  "schema_version": 1,
  "app_id": "sensor-recorder",
  "screen": {
    "id": "sensor-recorder.exported",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "sensor-recorder.exported.heading",
          "type": "text",
          "props": {
            "text": "EXPORT / READY",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "sensor-recorder.exported.summary",
          "type": "text",
          "props": {
            "text": "CSV",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Sensor export ready",
            "value": "session-001.csv"
          }
        },
        {
          "id": "sensor-recorder.exported.detail",
          "type": "live_card",
          "props": {
            "title": "SESSION-001.CSV",
            "body": "48 KiB / mock transfer complete",
            "progress": 1.0,
            "tone": "primary"
          }
        },
        {
          "id": "sensor-recorder.exported.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "sensor-recorder.exported.primary",
                "type": "button",
                "props": {
                  "label": "Session",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "sensor.session"
                },
                "semantics": {
                  "label": "Return to sensor session"
                }
              },
              {
                "id": "sensor-recorder.exported.secondary",
                "type": "button",
                "props": {
                  "label": "Home",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "sensor.home"
                },
                "semantics": {
                  "label": "Return to Sensor Recorder home"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
