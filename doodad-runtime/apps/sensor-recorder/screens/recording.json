{
  "schema_version": 1,
  "app_id": "sensor-recorder",
  "screen": {
    "id": "sensor-recorder.recording",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "sensor-recorder.recording.heading",
          "type": "text",
          "props": {
            "text": "RECORDING",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "sensor-recorder.recording.summary",
          "type": "text",
          "props": {
            "text": "50 Hz · 1,024",
            "style": "numeral",
            "max_lines": 2,
            "align": "center"
          },
          "semantics": {
            "label": "RECORDING",
            "value": "50 Hz · 1,024"
          }
        },
        {
          "id": "sensor-recorder.recording.detail",
          "type": "card",
          "props": {
            "title": "Deterministic fixture",
            "body": "X +0.04  Y −0.12  Z +0.98",
            "tone": "neutral"
          }
        },
        {
          "id": "sensor-recorder.recording.primary",
          "type": "button",
          "props": {
            "label": "Pause",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "sensor.pause"
          },
          "semantics": {
            "label": "Pause"
          }
        },
        {
          "id": "sensor-recorder.recording.secondary",
          "type": "button",
          "props": {
            "label": "Finish",
            "tone": "neutral",
            "variant": "outlined",
            "size": "default"
          },
          "events": {
            "tap": "sensor.finish"
          },
          "semantics": {
            "label": "Finish"
          }
        }
      ]
    }
  }
}
