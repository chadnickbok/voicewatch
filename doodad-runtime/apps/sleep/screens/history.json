{
  "schema_version": 1,
  "app_id": "sleep",
  "screen": {
    "id": "sleep.history",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "sleep.history.context",
          "type": "text",
          "props": {
            "text": "7 NIGHTS / GOOD",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "sleep.history.summary",
          "type": "text",
          "props": {
            "text": "7:28",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Seven-night average sleep duration",
            "value": "7 hours 28 minutes"
          }
        },
        {
          "id": "sleep.history.detail",
          "type": "live_card",
          "props": {
            "title": "AVERAGE / TARGET",
            "body": "Best 7:52 / variation 3.2%",
            "progress": 0.93,
            "tone": "primary"
          }
        },
        {
          "id": "sleep.history.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "sleep.history.primary",
                "type": "button",
                "props": {
                  "label": "Night",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "sleep.last"
                },
                "semantics": {
                  "label": "View last night's summary"
                }
              },
              {
                "id": "sleep.history.secondary",
                "type": "button",
                "props": {
                  "label": "Home",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "sleep.home"
                },
                "semantics": {
                  "label": "Return to the latest sleep result"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
