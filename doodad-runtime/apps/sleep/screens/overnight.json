{
  "schema_version": 1,
  "app_id": "sleep",
  "screen": {
    "id": "sleep.overnight",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "sleep.overnight.context",
          "type": "text",
          "props": {
            "text": "ASLEEP / AMBIENT",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "sleep.overnight.summary",
          "type": "text",
          "props": {
            "text": "6:18",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Current sleep duration",
            "value": "6 hours 18 minutes"
          }
        },
        {
          "id": "sleep.overnight.detail",
          "type": "live_card",
          "props": {
            "title": "SMART ALARM / 7:20",
            "body": "Motion low / on watch",
            "progress": 0.79,
            "tone": "primary"
          }
        },
        {
          "id": "sleep.overnight.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "sleep.overnight.primary",
                "type": "button",
                "props": {
                  "label": "Morning",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "sleep.morning"
                },
                "semantics": {
                  "label": "Simulate the morning summary"
                }
              },
              {
                "id": "sleep.overnight.secondary",
                "type": "button",
                "props": {
                  "label": "Wake",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "sleep.wake"
                },
                "semantics": {
                  "label": "Stop sleep tracking now"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
