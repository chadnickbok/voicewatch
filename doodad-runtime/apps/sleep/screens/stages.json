{
  "schema_version": 1,
  "app_id": "sleep",
  "screen": {
    "id": "sleep.stages",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "sleep.stages.context",
          "type": "text",
          "props": {
            "text": "STAGES / NIGHT",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "sleep.stages.summary",
          "type": "text",
          "props": {
            "text": "1:36",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Deep sleep duration",
            "value": "1 hour 36 minutes"
          }
        },
        {
          "id": "sleep.stages.detail",
          "type": "live_card",
          "props": {
            "title": "DEEP / 24%",
            "body": "Light 4:18 / REM 1:24",
            "progress": 0.24,
            "tone": "primary"
          }
        },
        {
          "id": "sleep.stages.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "sleep.stages.primary",
                "type": "button",
                "props": {
                  "label": "History",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "sleep.history"
                },
                "semantics": {
                  "label": "View seven-night history"
                }
              },
              {
                "id": "sleep.stages.secondary",
                "type": "button",
                "props": {
                  "label": "Back",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "sleep.summary"
                },
                "semantics": {
                  "label": "Return to sleep summary"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
