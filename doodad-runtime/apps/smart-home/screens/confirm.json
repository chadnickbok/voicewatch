{
  "schema_version": 1,
  "app_id": "smart-home",
  "screen": {
    "id": "smart-home.confirm",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "smart-home.confirm.context",
          "type": "text",
          "props": {
            "text": "DOOR / REVIEW",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "smart-home.confirm.summary",
          "type": "text",
          "props": {
            "text": "UNLOCK",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Confirm front door unlock",
            "value": "Unlock front door?"
          }
        },
        {
          "id": "smart-home.confirm.detail",
          "type": "live_card",
          "props": {
            "title": "SECURE / IDENTITY",
            "body": "Confirm once / audit logged",
            "progress": 0.5,
            "tone": "primary"
          }
        },
        {
          "id": "smart-home.confirm.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "smart-home.confirm.primary",
                "type": "button",
                "props": {
                  "label": "Unlock",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "home.confirm"
                },
                "semantics": {
                  "label": "Confirm unlock front door"
                }
              },
              {
                "id": "smart-home.confirm.secondary",
                "type": "button",
                "props": {
                  "label": "Cancel",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "home.cancel"
                },
                "semantics": {
                  "label": "Cancel front door unlock"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
