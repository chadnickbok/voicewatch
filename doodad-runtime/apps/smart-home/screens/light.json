{
  "schema_version": 1,
  "app_id": "smart-home",
  "screen": {
    "id": "smart-home.light",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "smart-home.light.context",
          "type": "text",
          "props": {
            "text": "LIVING / LIGHT",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "smart-home.light.summary",
          "type": "text",
          "props": {
            "text": "72%",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Living room light brightness",
            "value": "72 percent and on"
          }
        },
        {
          "id": "smart-home.light.detail",
          "type": "live_card",
          "props": {
            "title": "LIGHT ON / WARM",
            "body": "Updated / command 18",
            "progress": 0.72,
            "tone": "primary"
          }
        },
        {
          "id": "smart-home.light.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "smart-home.light.primary",
                "type": "button",
                "props": {
                  "label": "Turn off",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "home.fail"
                },
                "semantics": {
                  "label": "Turn off living room light"
                }
              },
              {
                "id": "smart-home.light.secondary",
                "type": "button",
                "props": {
                  "label": "Door",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "home.lock"
                },
                "semantics": {
                  "label": "Review front door lock"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
