{
  "schema_version": 1,
  "app_id": "smart-home",
  "screen": {
    "id": "smart-home.light",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "smart-home.light.heading",
          "type": "text",
          "props": {
            "text": "LIVING ROOM",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "smart-home.light.summary",
          "type": "text",
          "props": {
            "text": "Light on · 72%",
            "style": "numeral",
            "max_lines": 2,
            "align": "center"
          },
          "semantics": {
            "label": "LIVING ROOM",
            "value": "Light on · 72%"
          }
        },
        {
          "id": "smart-home.light.detail",
          "type": "card",
          "props": {
            "title": "Deterministic fixture",
            "body": "Optimistic update · ack #18",
            "tone": "neutral"
          }
        },
        {
          "id": "smart-home.light.primary",
          "type": "button",
          "props": {
            "label": "Fail next command",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "home.fail"
          },
          "semantics": {
            "label": "Fail next command"
          }
        },
        {
          "id": "smart-home.light.secondary",
          "type": "button",
          "props": {
            "label": "Front door",
            "tone": "neutral",
            "variant": "outlined",
            "size": "default"
          },
          "events": {
            "tap": "home.lock"
          },
          "semantics": {
            "label": "Front door"
          }
        }
      ]
    }
  }
}
