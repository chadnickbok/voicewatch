{
  "schema_version": 1,
  "app_id": "smart-home",
  "screen": {
    "id": "smart-home.rollback",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "smart-home.rollback.context",
          "type": "text",
          "props": {
            "text": "LIGHT / FAILED",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "smart-home.rollback.summary",
          "type": "text",
          "props": {
            "text": "72%",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Restored living room light brightness",
            "value": "72 percent and still on"
          }
        },
        {
          "id": "smart-home.rollback.detail",
          "type": "live_card",
          "props": {
            "title": "FAILED / RESTORED",
            "body": "Provider rejected / still on",
            "progress": 0.72,
            "tone": "primary"
          }
        },
        {
          "id": "smart-home.rollback.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "smart-home.rollback.primary",
                "type": "button",
                "props": {
                  "label": "Retry",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "home.retry"
                },
                "semantics": {
                  "label": "Retry light command"
                }
              },
              {
                "id": "smart-home.rollback.secondary",
                "type": "button",
                "props": {
                  "label": "Door",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "home.lock"
                },
                "semantics": {
                  "label": "Review front door lock"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
