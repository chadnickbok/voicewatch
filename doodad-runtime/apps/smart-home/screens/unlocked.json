{
  "schema_version": 1,
  "app_id": "smart-home",
  "screen": {
    "id": "smart-home.unlocked",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "smart-home.unlocked.context",
          "type": "text",
          "props": {
            "text": "DOOR / OPEN",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "smart-home.unlocked.summary",
          "type": "text",
          "props": {
            "text": "UNLOCKED",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Front door lock state",
            "value": "Unlocked"
          }
        },
        {
          "id": "smart-home.unlocked.detail",
          "type": "live_card",
          "props": {
            "title": "ACCESS / CONFIRMED",
            "body": "Audit 204 / lock when done",
            "progress": 1.0,
            "tone": "primary"
          }
        },
        {
          "id": "smart-home.unlocked.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "smart-home.unlocked.primary",
                "type": "button",
                "props": {
                  "label": "Lock",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "home.relock"
                },
                "semantics": {
                  "label": "Lock front door again"
                }
              },
              {
                "id": "smart-home.unlocked.secondary",
                "type": "button",
                "props": {
                  "label": "Home",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "home.home"
                },
                "semantics": {
                  "label": "Return to home favorites"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
