{
  "schema_version": 1,
  "app_id": "snake",
  "screen": {
    "id": "snake.game",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "snake.game.canvas",
          "type": "canvas",
          "props": {
            "display_list": "v1|C0|R1,4,4,120,120,18|T2,8,8,14,14,8,8,0000000000000000000000000223040000000000000000000000000000000000",
            "palette": "07110d,10271c,52d88b,a8f279,ffcf66",
            "width": 184,
            "height": 128
          },
          "events": {
            "tap": "snake.step"
          },
          "semantics": {
            "label": "Snake game board",
            "hint": "Tap the board to move forward"
          }
        },
        {
          "id": "snake.game.score-label",
          "type": "text",
          "props": {
            "text": "SCORE",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "snake.game.score",
          "type": "text",
          "props": {
            "text": "0",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Snake score",
            "value": "0"
          }
        },
        {
          "id": "snake.game.controls",
          "type": "keypad",
          "props": {
            "columns": 3,
            "keys": [
              "L",
              "GO",
              "R"
            ]
          },
          "events": {
            "tap": "snake.control"
          },
          "semantics": {
            "label": "Snake direction controls"
          }
        }
      ]
    }
  }
}
