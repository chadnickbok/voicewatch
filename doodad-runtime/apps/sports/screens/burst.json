{
  "schema_version": 1,
  "app_id": "sports",
  "screen": {
    "id": "sports.burst",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "sports.burst.context",
          "type": "text",
          "props": {
            "text": "UPDATE / 8TH",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "sports.burst.summary",
          "type": "text",
          "props": {
            "text": "5:2",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Score update",
            "value": "San Francisco 5, Los Angeles 2"
          }
        },
        {
          "id": "sports.burst.detail",
          "type": "live_card",
          "props": {
            "title": "DOUBLE / TWO RUNS",
            "body": "Lee / 3 updates merged",
            "progress": 0.84,
            "tone": "primary"
          }
        },
        {
          "id": "sports.burst.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "sports.burst.primary",
                "type": "button",
                "props": {
                  "label": "End",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "sports.end"
                },
                "semantics": {
                  "label": "Deliver final score"
                }
              },
              {
                "id": "sports.burst.secondary",
                "type": "button",
                "props": {
                  "label": "Live",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "sports.live"
                },
                "semantics": {
                  "label": "Return to live game"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
