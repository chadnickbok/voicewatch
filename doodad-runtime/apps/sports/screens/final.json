{
  "schema_version": 1,
  "app_id": "sports",
  "screen": {
    "id": "sports.final",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "sports.final.context",
          "type": "text",
          "props": {
            "text": "FINAL / SF",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "sports.final.summary",
          "type": "text",
          "props": {
            "text": "5:3",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Final score",
            "value": "San Francisco 5, Los Angeles 3"
          }
        },
        {
          "id": "sports.final.detail",
          "type": "live_card",
          "props": {
            "title": "SF WINS / FINAL",
            "body": "One alert / follow ended",
            "progress": 1.0,
            "tone": "primary"
          }
        },
        {
          "id": "sports.final.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "sports.final.primary",
                "type": "button",
                "props": {
                  "label": "Plays",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "sports.plays"
                },
                "semantics": {
                  "label": "Show scoring plays"
                }
              },
              {
                "id": "sports.final.secondary",
                "type": "button",
                "props": {
                  "label": "Again",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "sports.follow"
                },
                "semantics": {
                  "label": "Follow rematch"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
