{
  "schema_version": 1,
  "app_id": "sports",
  "screen": {
    "id": "sports.live",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "sports.live.context",
          "type": "text",
          "props": {
            "text": "FOLLOW / TOP 8",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "sports.live.summary",
          "type": "text",
          "props": {
            "text": "3:2",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Followed live baseball game",
            "value": "San Francisco 3, Los Angeles 2, top of the eighth"
          }
        },
        {
          "id": "sports.live.detail",
          "type": "live_card",
          "props": {
            "title": "AT BAT / 1 OUT",
            "body": "Runners 1st + 2nd",
            "progress": 0.78,
            "tone": "primary"
          }
        },
        {
          "id": "sports.live.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "sports.live.primary",
                "type": "button",
                "props": {
                  "label": "Update",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "sports.burst"
                },
                "semantics": {
                  "label": "Deliver latest score update"
                }
              },
              {
                "id": "sports.live.secondary",
                "type": "button",
                "props": {
                  "label": "Stop",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "sports.unfollow"
                },
                "semantics": {
                  "label": "Stop following game"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
