{
  "schema_version": 1,
  "app_id": "sports",
  "screen": {
    "id": "sports.timeline",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "sports.timeline.context",
          "type": "text",
          "props": {
            "text": "SCORING / 8TH",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "sports.timeline.summary",
          "type": "text",
          "props": {
            "text": "5 RUNS",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Scoring plays",
            "value": "5 runs across 4 scoring plays"
          }
        },
        {
          "id": "sports.timeline.detail",
          "type": "live_card",
          "props": {
            "title": "LEE DOUBLE / +2",
            "body": "Four scoring plays total",
            "progress": 1.0,
            "tone": "primary"
          }
        },
        {
          "id": "sports.timeline.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "sports.timeline.primary",
                "type": "button",
                "props": {
                  "label": "Final",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "sports.final"
                },
                "semantics": {
                  "label": "Return to final score"
                }
              },
              {
                "id": "sports.timeline.secondary",
                "type": "button",
                "props": {
                  "label": "Home",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "sports.home"
                },
                "semantics": {
                  "label": "Return to game list"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
