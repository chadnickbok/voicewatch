{
  "schema_version": 1,
  "app_id": "tasks",
  "screen": {
    "id": "tasks.home",
    "type": "screen",
    "props": {
      "gap": "md",
      "align": "stretch",
      "children": [
        {
          "id": "tasks.heading",
          "type": "text",
          "props": {
            "text": "TASKS",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "tasks.summary",
          "type": "card",
          "props": {
            "title": "Groceries · 2 left",
            "body": "Milk, coffee · synced locally",
            "tone": "primary"
          }
        },
        {
          "id": "tasks.open",
          "type": "button",
          "props": {
            "label": "Open groceries",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "tasks.open"
          },
          "semantics": {
            "label": "Open groceries list"
          }
        },
        {
          "id": "tasks.voice_add",
          "type": "button",
          "props": {
            "label": "Voice · add bananas",
            "tone": "tertiary",
            "variant": "tonal",
            "size": "default"
          },
          "events": {
            "tap": "tasks.add.bananas"
          },
          "semantics": {
            "label": "Add bananas by voice"
          }
        }
      ]
    }
  }
}
