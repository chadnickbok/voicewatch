{
  "schema_version": 1,
  "app_id": "tasks",
  "screen": {
    "id": "tasks.today",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "tasks.list",
          "type": "scroll",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "tasks.list.heading",
                "type": "text",
                "props": {
                  "text": "TODAY  /  1 LEFT",
                  "style": "label",
                  "max_lines": 1,
                  "align": "center"
                }
              },
              {
                "id": "tasks.milk",
                "type": "toggle",
                "props": {
                  "label": "Milk",
                  "checked": true,
                  "tone": "primary"
                },
                "events": {
                  "checkedChanged": "tasks.toggle.milk"
                },
                "semantics": {
                  "label": "Milk, complete"
                }
              },
              {
                "id": "tasks.coffee",
                "type": "toggle",
                "props": {
                  "label": "Coffee",
                  "checked": false,
                  "tone": "primary"
                },
                "events": {
                  "checkedChanged": "tasks.toggle.coffee"
                },
                "semantics": {
                  "label": "Coffee, incomplete"
                }
              },
              {
                "id": "tasks.add",
                "type": "button",
                "props": {
                  "label": "+ Add by voice",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "tasks.add.bananas"
                },
                "semantics": {
                  "label": "Add a task by voice"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
