{
  "schema_version": 1,
  "app_id": "tasks",
  "screen": {
    "id": "tasks.groceries",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "tasks.list.heading",
          "type": "text",
          "props": {
            "text": "GROCERIES · 1 LEFT",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "tasks.milk",
          "type": "button",
          "props": {
            "label": "✓  Milk · undo",
            "tone": "tertiary",
            "variant": "tonal",
            "size": "compact"
          },
          "events": {
            "tap": "tasks.undo.milk"
          },
          "semantics": {
            "label": "Undo completed milk"
          }
        },
        {
          "id": "tasks.coffee",
          "type": "button",
          "props": {
            "label": "○  Coffee",
            "tone": "neutral",
            "variant": "tonal",
            "size": "compact"
          },
          "events": {
            "tap": "tasks.toggle.coffee"
          },
          "semantics": {
            "label": "Complete coffee"
          }
        },
        {
          "id": "tasks.add",
          "type": "button",
          "props": {
            "label": "+ Bananas",
            "tone": "tertiary",
            "variant": "text",
            "size": "compact"
          },
          "events": {
            "tap": "tasks.add.bananas"
          },
          "semantics": {
            "label": "Add bananas"
          }
        },
        {
          "id": "tasks.back",
          "type": "button",
          "props": {
            "label": "Back",
            "tone": "neutral",
            "variant": "text",
            "size": "compact"
          },
          "events": {
            "tap": "tasks.back"
          },
          "semantics": {
            "label": "Back to task lists"
          }
        }
      ]
    }
  }
}
