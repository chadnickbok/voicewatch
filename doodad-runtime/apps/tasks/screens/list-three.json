{
  "schema_version": 1,
  "app_id": "tasks",
  "screen": {
    "id": "tasks.today",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "tasks.list",
          "type": "scroll",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "tasks.list.heading",
                "type": "text",
                "props": {
                  "text": "TODAY  /  3 LEFT",
                  "style": "label",
                  "max_lines": 1,
                  "align": "center"
                }
              },
              {
                "id": "tasks.milk",
                "type": "toggle",
                "props": {
                  "label": "Milk",
                  "checked": false,
                  "tone": "primary"
                },
                "events": {
                  "checkedChanged": "tasks.toggle.milk"
                },
                "semantics": {
                  "label": "Milk, incomplete"
                }
              },
              {
                "id": "tasks.coffee",
                "type": "toggle",
                "props": {
                  "label": "Coffee",
                  "checked": false,
                  "tone": "primary"
                },
                "events": {
                  "checkedChanged": "tasks.toggle.coffee"
                },
                "semantics": {
                  "label": "Coffee, incomplete"
                }
              },
              {
                "id": "tasks.bananas",
                "type": "toggle",
                "props": {
                  "label": "Bananas",
                  "checked": false,
                  "tone": "primary"
                },
                "events": {
                  "checkedChanged": "tasks.toggle.bananas"
                },
                "semantics": {
                  "label": "Bananas, incomplete"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
