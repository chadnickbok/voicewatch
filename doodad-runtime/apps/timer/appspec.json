{
  "schema_version": 1,
  "app_id": "timer",
  "screen": {
    "id": "timer.home",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "timer.progress",
          "type": "progress",
          "props": {
            "label": "Timer progress",
            "value": 60,
            "maximum": 60,
            "style": "circular",
            "tone": "primary"
          },
          "semantics": {
            "label": "Timer progress",
            "value": "1 minute remaining"
          }
        },
        {
          "id": "timer.summary",
          "type": "text",
          "props": {
            "text": "1:00",
            "style": "numeral",
            "max_lines": 2,
            "align": "center"
          },
          "semantics": {
            "label": "Timer Suite status",
            "value": "1 minute"
          }
        },
        {
          "id": "timer.duration",
          "type": "stepper",
          "props": {
            "label": "Minutes",
            "value": 1,
            "unit": "min",
            "minimum": 1,
            "maximum": 60,
            "step": 1
          },
          "events": {
            "valueCommitted": "timer.duration.changed"
          },
          "semantics": {
            "label": "Timer duration",
            "value": "1 minute"
          }
        },
        {
          "id": "timer.primary",
          "type": "button",
          "props": {
            "label": "Start",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "timer.primary"
          },
          "semantics": {
            "label": "Timer action"
          }
        }
      ]
    }
  }
}
