{
  "schema_version": 1,
  "app_id": "transit",
  "screen": {
    "id": "transit.alert",
    "type": "screen",
    "props": {
      "gap": "sm",
      "align": "stretch",
      "children": [
        {
          "id": "transit.alert.heading",
          "type": "text",
          "props": {
            "text": "SERVICE ALERT",
            "style": "label",
            "max_lines": 1
          }
        },
        {
          "id": "transit.alert.summary",
          "type": "text",
          "props": {
            "text": "N delayed 6 min",
            "style": "numeral",
            "max_lines": 2,
            "align": "center"
          },
          "semantics": {
            "label": "SERVICE ALERT",
            "value": "N delayed 6 min"
          }
        },
        {
          "id": "transit.alert.detail",
          "type": "card",
          "props": {
            "title": "Deterministic fixture",
            "body": "Track work near Duboce",
            "tone": "neutral"
          }
        },
        {
          "id": "transit.alert.primary",
          "type": "button",
          "props": {
            "label": "Departures",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "transit.departures"
          },
          "semantics": {
            "label": "Departures"
          }
        },
        {
          "id": "transit.alert.secondary",
          "type": "button",
          "props": {
            "label": "Go offline",
            "tone": "neutral",
            "variant": "outlined",
            "size": "default"
          },
          "events": {
            "tap": "transit.offline"
          },
          "semantics": {
            "label": "Go offline"
          }
        }
      ]
    }
  }
}
