{
  "schema_version": 1,
  "app_id": "transit",
  "screen": {
    "id": "transit.alert",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "transit.alert.context",
          "type": "text",
          "props": {
            "text": "SERVICE / N LINE",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "transit.alert.summary",
          "type": "text",
          "props": {
            "text": "6 MIN",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "N line service delay",
            "value": "6 minute delay"
          }
        },
        {
          "id": "transit.alert.detail",
          "type": "live_card",
          "props": {
            "title": "DELAY / TRACK WORK",
            "body": "Near Duboce / add 6 min",
            "progress": 0.65,
            "tone": "primary"
          }
        },
        {
          "id": "transit.alert.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "transit.alert.primary",
                "type": "button",
                "props": {
                  "label": "Times",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "transit.departures"
                },
                "semantics": {
                  "label": "Return to departures"
                }
              },
              {
                "id": "transit.alert.secondary",
                "type": "button",
                "props": {
                  "label": "Offline",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "transit.offline"
                },
                "semantics": {
                  "label": "Use cached departures"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
