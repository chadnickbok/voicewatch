{
  "schema_version": 1,
  "app_id": "transit",
  "screen": {
    "id": "transit.departures",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "transit.departures.context",
          "type": "text",
          "props": {
            "text": "CASTRO / NORTH",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "transit.departures.summary",
          "type": "text",
          "props": {
            "text": "3 MIN",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Next northbound N train",
            "value": "3 minutes"
          }
        },
        {
          "id": "transit.departures.detail",
          "type": "live_card",
          "props": {
            "title": "N TRAIN / PLATFORM 2",
            "body": "Next 14 / L in 8 min",
            "progress": 0.2,
            "tone": "primary"
          }
        },
        {
          "id": "transit.departures.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "transit.departures.primary",
                "type": "button",
                "props": {
                  "label": "Offline",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "transit.offline"
                },
                "semantics": {
                  "label": "Simulate offline departures"
                }
              },
              {
                "id": "transit.departures.secondary",
                "type": "button",
                "props": {
                  "label": "Alert",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "transit.alert"
                },
                "semantics": {
                  "label": "View N line service alert"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
