{
  "schema_version": 1,
  "app_id": "transit",
  "screen": {
    "id": "transit.recovered",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "transit.recovered.context",
          "type": "text",
          "props": {
            "text": "UPDATED / NOW",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "transit.recovered.summary",
          "type": "text",
          "props": {
            "text": "4 MIN",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Updated northbound N train",
            "value": "4 minutes"
          }
        },
        {
          "id": "transit.recovered.detail",
          "type": "live_card",
          "props": {
            "title": "N TRAIN / PLATFORM 2",
            "body": "Selection kept / next 15",
            "progress": 0.25,
            "tone": "primary"
          }
        },
        {
          "id": "transit.recovered.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "transit.recovered.primary",
                "type": "button",
                "props": {
                  "label": "Alert",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "transit.alert"
                },
                "semantics": {
                  "label": "View N line service alert"
                }
              },
              {
                "id": "transit.recovered.secondary",
                "type": "button",
                "props": {
                  "label": "Times",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "transit.refresh"
                },
                "semantics": {
                  "label": "Refresh departures again"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
