{
  "schema_version": 1,
  "app_id": "transit",
  "screen": {
    "id": "transit.stale",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "transit.stale.context",
          "type": "text",
          "props": {
            "text": "CACHE / 18 MIN",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "transit.stale.summary",
          "type": "text",
          "props": {
            "text": "2 MIN",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Cached northbound N train",
            "value": "2 minutes in cached schedule"
          }
        },
        {
          "id": "transit.stale.detail",
          "type": "live_card",
          "props": {
            "title": "CACHE / N TRAIN",
            "body": "Schedule only / reconnect",
            "progress": 0.35,
            "tone": "primary"
          }
        },
        {
          "id": "transit.stale.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "transit.stale.primary",
                "type": "button",
                "props": {
                  "label": "Retry",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "transit.reconnect"
                },
                "semantics": {
                  "label": "Reconnect live departures"
                }
              },
              {
                "id": "transit.stale.secondary",
                "type": "button",
                "props": {
                  "label": "Keep",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "transit.cache"
                },
                "semantics": {
                  "label": "Keep cached departures"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
