{
  "schema_version": 1,
  "app_id": "voice-notes",
  "screen": {
    "id": "voice-notes.home",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "voice-notes.ready",
          "type": "text",
          "props": {
            "text": "READY / WATCH",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Recorder status",
            "value": "Ready"
          }
        },
        {
          "id": "voice-notes.record",
          "type": "voice_orb",
          "props": {
            "state": "idle",
            "transcript": "Tap to record"
          },
          "events": {
            "tap": "voice-notes.record"
          },
          "semantics": {
            "label": "Record voice note"
          }
        },
        {
          "id": "voice-notes.recent",
          "type": "card",
          "props": {
            "title": "LAST NOTE / 00:24",
            "body": "Train after lunch / synced",
            "tone": "neutral"
          }
        }
      ]
    }
  }
}
