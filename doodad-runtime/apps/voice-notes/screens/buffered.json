{
  "schema_version": 1,
  "app_id": "voice-notes",
  "screen": {
    "id": "voice-notes.buffered",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "voice-notes.buffered.heading",
          "type": "text",
          "props": {
            "text": "CAPTURED",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "voice-notes.buffered.summary",
          "type": "text",
          "props": {
            "text": "00:31",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Captured audio duration",
            "value": "00:31"
          }
        },
        {
          "id": "voice-notes.buffered.detail",
          "type": "live_card",
          "props": {
            "title": "READY / TRANSCRIBE",
            "body": "Local audio / 3 chunks",
            "progress": 1,
            "tone": "primary"
          }
        },
        {
          "id": "voice-notes.buffered.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "voice-notes.buffered.transcribe",
                "type": "button",
                "props": {
                  "label": "Text",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "voice-notes.transcribe"
                },
                "semantics": {
                  "label": "Transcribe captured note"
                }
              },
              {
                "id": "voice-notes.buffered.delete",
                "type": "button",
                "props": {
                  "label": "Delete",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "voice-notes.delete"
                },
                "semantics": {
                  "label": "Delete captured note"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
