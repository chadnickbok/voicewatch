{
  "schema_version": 1,
  "app_id": "voice-notes",
  "screen": {
    "id": "voice-notes.recording",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "voice-notes.recording.heading",
          "type": "text",
          "props": {
            "text": "REC / LOCAL",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "voice-notes.recording.summary",
          "type": "text",
          "props": {
            "text": "00:18",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Recording elapsed time",
            "value": "00:18"
          }
        },
        {
          "id": "voice-notes.recording.detail",
          "type": "live_card",
          "props": {
            "title": "SAFE / 3 CHUNKS",
            "body": "On watch / sleeps safely",
            "progress": 0.6,
            "tone": "primary"
          }
        },
        {
          "id": "voice-notes.recording.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "voice-notes.recording.finish",
                "type": "button",
                "props": {
                  "label": "Finish",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "voice-notes.finish-capture"
                },
                "semantics": {
                  "label": "Finish recording"
                }
              },
              {
                "id": "voice-notes.recording.pause",
                "type": "button",
                "props": {
                  "label": "Pause",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "voice-notes.pause"
                },
                "semantics": {
                  "label": "Pause recording"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
