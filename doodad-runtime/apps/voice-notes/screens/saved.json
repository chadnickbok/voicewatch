{
  "schema_version": 1,
  "app_id": "voice-notes",
  "screen": {
    "id": "voice-notes.saved",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "voice-notes.saved.heading",
          "type": "text",
          "props": {
            "text": "SAVED / WATCH",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "voice-notes.saved.summary",
          "type": "text",
          "props": {
            "text": "00:31",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Saved voice note duration",
            "value": "00:31"
          }
        },
        {
          "id": "voice-notes.saved.detail",
          "type": "live_card",
          "props": {
            "title": "TRAIN AFTER LUNCH",
            "body": "Sync queued / deduped",
            "progress": 1,
            "tone": "primary"
          }
        },
        {
          "id": "voice-notes.saved.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "voice-notes.saved.open",
                "type": "button",
                "props": {
                  "label": "Open",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "voice-notes.open"
                },
                "semantics": {
                  "label": "Open saved note"
                }
              },
              {
                "id": "voice-notes.saved.done",
                "type": "button",
                "props": {
                  "label": "Done",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "voice-notes.done"
                },
                "semantics": {
                  "label": "Return to recorder"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
