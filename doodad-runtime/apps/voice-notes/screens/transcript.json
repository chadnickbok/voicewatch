{
  "schema_version": 1,
  "app_id": "voice-notes",
  "screen": {
    "id": "voice-notes.transcript",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "voice-notes.transcript.heading",
          "type": "text",
          "props": {
            "text": "TRANSCRIPT",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "voice-notes.transcript.summary",
          "type": "text",
          "props": {
            "text": "1 NOTE",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Transcript count",
            "value": "1 note"
          }
        },
        {
          "id": "voice-notes.transcript.detail",
          "type": "live_card",
          "props": {
            "title": "7 WORDS / 00:31",
            "body": "Book the train after lunch.",
            "progress": 1,
            "tone": "primary"
          }
        },
        {
          "id": "voice-notes.transcript.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "voice-notes.transcript.save",
                "type": "button",
                "props": {
                  "label": "Save",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "voice-notes.save"
                },
                "semantics": {
                  "label": "Save voice note"
                }
              },
              {
                "id": "voice-notes.transcript.again",
                "type": "button",
                "props": {
                  "label": "Again",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "voice-notes.again"
                },
                "semantics": {
                  "label": "Record again"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
