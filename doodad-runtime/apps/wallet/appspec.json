{
  "schema_version": 1,
  "app_id": "wallet",
  "screen": {
    "id": "wallet.home",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "wallet.home.context",
          "type": "text",
          "props": {
            "text": "SFO / JFK / TODAY",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "wallet.summary",
          "type": "text",
          "props": {
            "text": "8:10",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Boarding time",
            "value": "8:10 AM"
          }
        },
        {
          "id": "wallet.home.detail",
          "type": "live_card",
          "props": {
            "title": "BOARD / GATE B12",
            "body": "18A / offline ready",
            "progress": 0.72,
            "tone": "primary"
          }
        },
        {
          "id": "wallet.home.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "wallet.primary",
                "type": "button",
                "props": {
                  "label": "Pass",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "wallet.primary"
                },
                "semantics": {
                  "label": "Show boarding pass"
                }
              },
              {
                "id": "wallet.home.qr",
                "type": "button",
                "props": {
                  "label": "Code",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "wallet.qr"
                },
                "semantics": {
                  "label": "Show boarding code"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
