{
  "schema_version": 1,
  "app_id": "wallet",
  "screen": {
    "id": "wallet.qr",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "wallet.qr.context",
          "type": "text",
          "props": {
            "text": "SFO / JFK / B12",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "wallet.qr.code",
          "type": "image",
          "props": {
            "asset": "29ee6d97e8928b49fbbaa49c20a439a1930c4d82de2217490abbe5235a798254",
            "fit": "contain"
          },
          "semantics": {
            "label": "Demo boarding pass QR code for seat 18A"
          }
        },
        {
          "id": "wallet.qr.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "wallet.qr.primary",
                "type": "button",
                "props": {
                  "label": "Done",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "wallet.done"
                },
                "semantics": {
                  "label": "Return to boarding pass"
                }
              },
              {
                "id": "wallet.qr.secondary",
                "type": "button",
                "props": {
                  "label": "Test",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "wallet.bad"
                },
                "semantics": {
                  "label": "Test an invalid pass update"
                }
              }
            ]
          }
        }
      ]
    }
