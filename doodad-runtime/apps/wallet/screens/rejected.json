{
  "schema_version": 1,
  "app_id": "wallet",
  "screen": {
    "id": "wallet.rejected",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "wallet.rejected.context",
          "type": "text",
          "props": {
            "text": "UPDATE / DENIED",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "wallet.rejected.summary",
          "type": "text",
          "props": {
            "text": "SAFE",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Invalid pass update rejected",
            "value": "Last verified pass remains safe"
          }
        },
        {
          "id": "wallet.rejected.detail",
          "type": "live_card",
          "props": {
            "title": "SIGNATURE / INVALID",
            "body": "Verified pass kept",
            "progress": 0.5,
            "tone": "error"
          }
        },
        {
          "id": "wallet.rejected.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "wallet.rejected.primary",
                "type": "button",
                "props": {
                  "label": "Safe",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "wallet.safe"
                },
                "semantics": {
                  "label": "Use last verified pass"
                }
              },
              {
                "id": "wallet.rejected.secondary",
                "type": "button",
                "props": {
                  "label": "Review",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "wallet.review"
                },
                "semantics": {
                  "label": "Review rejected update"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
