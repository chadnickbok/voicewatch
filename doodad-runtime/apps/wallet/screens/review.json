{
  "schema_version": 1,
  "app_id": "wallet",
  "screen": {
    "id": "wallet.review",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "wallet.review.context",
          "type": "text",
          "props": {
            "text": "ISSUER / REVIEW",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "wallet.review.summary",
          "type": "text",
          "props": {
            "text": "MISMATCH",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Issuer mismatch",
            "value": "Untrusted update"
          }
        },
        {
          "id": "wallet.review.detail",
          "type": "live_card",
          "props": {
            "title": "ISSUER / MISMATCH",
            "body": "Mock Air / Doodad Air",
            "progress": 0.5,
            "tone": "error"
          }
        },
        {
          "id": "wallet.review.actions",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "wallet.review.primary",
                "type": "button",
                "props": {
                  "label": "Reject",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "default"
                },
                "events": {
                  "tap": "wallet.reject"
                },
                "semantics": {
                  "label": "Reject untrusted update"
                }
              },
              {
                "id": "wallet.review.secondary",
                "type": "button",
                "props": {
                  "label": "Home",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "default"
                },
                "events": {
                  "tap": "wallet.home"
                },
                "semantics": {
                  "label": "Return to wallet home"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
