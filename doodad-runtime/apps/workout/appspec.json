{
  "schema_version": 1,
  "app_id": "workout",
  "screen": {
    "id": "powerlifting.today",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "powerlifting.today.kicker",
          "type": "text",
          "props": {
            "text": "SAT / WEEK 4",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "powerlifting.today.hero",
          "type": "card",
          "props": {
            "title": "HEAVY DAY",
            "body": "SQUAT / BENCH / DEADLIFT",
            "tone": "primary"
          }
        },
        {
          "id": "powerlifting.today.volume",
          "type": "card",
          "props": {
            "title": "14 SETS",
            "body": "3 LIFTS / ABOUT 67 MIN",
            "tone": "neutral"
          }
        },
        {
          "id": "powerlifting.today.start",
          "type": "button",
          "props": {
            "label": "START WORKOUT",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "workout.start",
            "longPress": "workout.resume.preview"
          },
          "semantics": {
            "label": "START WORKOUT"
          }
        }
      ]
    }
  }
}
