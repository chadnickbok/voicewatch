{
  "schema_version": 1,
  "app_id": "workout",
  "screen": {
    "id": "active_set",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "active_set.heading",
          "type": "text",
          "props": {
            "text": "SQUAT  /  SET 3/5",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "active_set.weight",
          "type": "stepper",
          "props": {
            "label": "Weight",
            "value": 135,
            "unit": "lb",
            "minimum": 45,
            "maximum": 500,
            "step": 5
          },
          "events": {
            "valueCommitted": "set_weight"
          },
          "semantics": {
            "label": "Current set weight",
            "value": "135 pounds"
          }
        },
        {
          "id": "active_set.summary",
          "type": "live_card",
          "props": {
            "title": "TARGET  /  8 REPS",
            "body": "Rest after set  /  1:00",
            "progress": 0.63,
            "tone": "neutral"
          },
          "semantics": {
            "label": "Set target",
            "value": "8 reps, then rest 1 minute"
          }
        },
        {
          "id": "active_set.complete",
          "type": "button",
          "props": {
            "label": "Log set",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "complete_set"
          },
          "semantics": {
            "label": "Log current set"
          }
        }
      ]
    }
  }
}
