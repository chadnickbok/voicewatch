{
  "schema_version": 1,
  "app_id": "workout",
  "screen": {
    "id": "workout.next-set",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "workout.next.heading",
          "type": "text",
          "props": {
        "text": "SQUAT  /  SET 4/5",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "workout.next.weight",
          "type": "stepper",
          "props": {
            "label": "Weight",
            "value": 135,
            "unit": "lb",
            "minimum": 45,
            "maximum": 500,
            "step": 5
          },
          "events": {
            "valueCommitted": "workout.next.weight"
          },
          "semantics": {
            "label": "Next set weight",
            "value": "135 pounds"
          }
        },
        {
          "id": "workout.next.target",
          "type": "live_card",
          "props": {
            "title": "TARGET  /  8 REPS",
            "body": "Previous set  /  145 lb",
            "progress": 0.8,
            "tone": "neutral"
          },
          "semantics": {
            "label": "Next set target",
            "value": "8 reps"
          }
        },
        {
          "id": "workout.next.complete",
          "type": "button",
          "props": {
            "label": "Log set",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "workout.next.complete"
          },
          "semantics": {
            "label": "Log next set"
          }
        }
      ]
    }
  }
}
