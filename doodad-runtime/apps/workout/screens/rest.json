{
  "schema_version": 1,
  "app_id": "workout",
  "screen": {
    "id": "workout.rest",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "workout.rest.heading",
          "type": "text",
          "props": {
        "text": "REST  /  SET 3",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "workout.rest.time",
          "type": "text",
          "props": {
            "text": "1:00",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          },
          "semantics": {
            "label": "Rest time remaining",
            "value": "1 minute"
          }
        },
        {
          "id": "workout.rest.detail",
          "type": "live_card",
          "props": {
            "title": "145 LB  X  8",
            "body": "NEXT  /  SET 4 OF 5",
            "progress": 0.0,
            "tone": "neutral"
          },
          "semantics": {
            "label": "Recorded set",
            "value": "145 pounds for 8 reps"
          }
        },
        {
          "id": "workout.rest.finish",
          "type": "button",
          "props": {
            "label": "Next set",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "workout.rest.finish"
          },
          "semantics": {
            "label": "Finish rest and open next set"
          }
        },
        {
          "id": "workout.rest.end",
          "type": "button",
          "props": {
            "label": "End",
            "tone": "neutral",
            "variant": "tonal",
            "size": "default"
          },
          "events": {
            "tap": "workout.end"
          },
          "semantics": {
            "label": "End workout"
          }
        }
      ]
    }
  }
}
