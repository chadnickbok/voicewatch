{
  "schema_version": 1,
  "app_id": "workout",
  "screen": {
    "id": "powerlifting.rest",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "powerlifting.rest.label",
          "type": "text",
          "props": {
            "text": "REST",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "powerlifting.rest.time",
          "type": "text",
          "props": {
            "text": "2:41",
            "style": "numeral",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "powerlifting.rest.progress",
          "type": "progress",
          "props": {
            "label": "Workout progress",
            "value": 19,
            "maximum": 180,
            "style": "linear",
            "tone": "primary"
          },
          "semantics": {
            "label": "Workout progress",
            "value": "19 of 180"
          }
        },
        {
          "id": "powerlifting.rest.next",
          "type": "card",
          "props": {
            "title": "NEXT  /  142.5 KG X 5",
            "body": "SET 4 OF 5 / HOLD TO EDIT LAST",
            "tone": "primary"
          },
          "events": {
            "tap": "workout.plates",
            "longPress": "workout.edit.result"
          },
          "semantics": {
            "label": "NEXT  /  142.5 KG X 5"
          }
        },
        {
          "id": "powerlifting.rest.controls",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "powerlifting.rest.extend",
                "type": "button",
                "props": {
                  "label": "+30",
                  "tone": "primary",
                  "variant": "filled",
                  "size": "compact"
                },
                "events": {
                  "tap": "workout.rest.extend"
                },
                "semantics": {
                  "label": "+30"
                }
              },
              {
                "id": "powerlifting.rest.skip",
                "type": "button",
                "props": {
                  "label": "SKIP",
                  "tone": "neutral",
                  "variant": "tonal",
                  "size": "compact"
                },
                "events": {
                  "tap": "workout.rest.skip"
                },
                "semantics": {
                  "label": "SKIP"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
