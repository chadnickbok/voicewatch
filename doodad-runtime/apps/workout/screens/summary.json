{
  "schema_version": 1,
  "app_id": "workout",
  "screen": {
    "id": "powerlifting.summary",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "powerlifting.summary.title",
          "type": "text",
          "props": {
            "text": "WORKOUT COMPLETE",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "powerlifting.summary.metrics",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "powerlifting.summary.sets",
                "type": "text",
                "props": {
                  "text": "14 SETS",
                  "style": "title",
                  "max_lines": 1,
                  "align": "center"
                }
              },
              {
                "id": "powerlifting.summary.volume",
                "type": "text",
                "props": {
                  "text": "6,420 KG",
                  "style": "title",
                  "max_lines": 1,
                  "align": "center"
                }
              },
              {
                "id": "powerlifting.summary.duration",
                "type": "text",
                "props": {
                  "text": "1:07:32",
                  "style": "title",
                  "max_lines": 1,
                  "align": "center"
                }
              }
            ]
          }
        },
        {
          "id": "powerlifting.summary.pr",
          "type": "card",
          "props": {
            "title": "NEW 5RM  /  142.5 KG",
            "body": "BACK SQUAT",
            "tone": "secondary"
          }
        },
        {
          "id": "powerlifting.summary.done",
          "type": "button",
          "props": {
            "label": "DONE",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "workout.summary.done"
          },
          "semantics": {
            "label": "DONE"
          }
        }
      ]
    }
  }
}
