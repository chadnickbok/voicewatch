{
  "schema_version": 1,
  "app_id": "workout",
  "screen": {
    "id": "workout.summary",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "workout.summary.heading",
          "type": "text",
          "props": {
            "text": "WORKOUT SAVED",
            "style": "label",
            "max_lines": 1,
            "align": "center"
          }
        },
        {
          "id": "workout.summary.metrics",
          "type": "row",
          "props": {
            "gap": "xs",
            "align": "stretch",
            "children": [
              {
                "id": "workout.summary.sets",
                "type": "text",
                "props": {
                  "text": "4 sets",
                  "style": "title",
                  "max_lines": 1,
                  "align": "center"
                },
                "semantics": {
                  "label": "Sets completed",
                  "value": "4"
                }
              },
              {
                "id": "workout.summary.volume",
                "type": "text",
                "props": {
                  "text": "4,320 lb",
                  "style": "title",
                  "max_lines": 1,
                  "align": "center"
                },
                "semantics": {
                  "label": "Training volume",
                  "value": "4,320 pounds"
                }
              }
            ]
          }
        },
        {
          "id": "workout.summary.detail",
          "type": "card",
          "props": {
            "title": "Squat  /  4 x 8",
            "body": "12:08 total  /  saved offline",
            "tone": "neutral"
          }
        },
        {
          "id": "workout.summary.again",
          "type": "button",
          "props": {
            "label": "Again",
            "tone": "primary",
            "variant": "filled",
            "size": "default"
          },
          "events": {
            "tap": "workout.again"
          },
          "semantics": {
            "label": "Start another workout"
          }
        }
      ]
    }
  }
}
