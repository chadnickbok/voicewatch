{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doodad://contracts/agent-contract-v1",
  "title": "Doodad agent-readable application contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_id", "app_version", "host_abi", "display_name", "purpose", "examples", "aliases", "views", "actions"],
  "properties": {
    "schema_version": {"const": 1},
    "app_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
    "app_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "host_abi": {"type": "integer", "minimum": 1},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 240},
    "examples": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "aliases": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 48}},
    "views": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/view"}},
    "actions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "schemaPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {"$ref": {"type": "string", "format": "uri"}}
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "result_schema", "permissions", "foreground_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "result_schema": {"$ref": "#/$defs/schemaPointer"},
        "permissions": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
        "foreground_required": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "input_schema", "result_schema", "effect", "confirmation", "idempotency", "permissions", "foreground_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "input_schema": {"$ref": "#/$defs/schemaPointer"},
        "result_schema": {"$ref": "#/$defs/schemaPointer"},
        "effect": {"enum": ["read", "reversible_write", "destructive_write", "external_side_effect"]},
        "confirmation": {"enum": ["never", "when_ambiguous", "always"]},
        "idempotency": {"enum": ["not_applicable", "optional", "required"]},
        "permissions": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
        "foreground_required": {"type": "boolean"}
      }
    }
  }
}
