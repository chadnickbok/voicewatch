{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doodad.dev/schemas/conformance-scenario-v1.schema.json",
  "title": "Doodad deterministic conformance scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "app_id", "initial_state", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "app_id": {"$ref": "#/$defs/id"},
    "initial_state": {"$ref": "#/$defs/initial"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "initial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "timezone_offset_minutes",
        "app_state",
        "display_state",
        "connectivity"
      ],
      "properties": {
        "wall_time_ms": {"type": "integer"},
        "timezone_offset_minutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "app_state": {
          "enum": ["stopped", "foreground", "background", "suspended", "crashed"]
        },
        "display_state": {"enum": ["awake", "asleep"]},
        "connectivity": {"enum": ["online", "degraded", "offline"]}
      }
    },
    "step": {
      "oneOf": [
        {"$ref": "#/$defs/advance"},
        {"$ref": "#/$defs/set_wall"},
        {"$ref": "#/$defs/lifecycle"},
        {"$ref": "#/$defs/reboot"},
        {"$ref": "#/$defs/provider"},
        {"$ref": "#/$defs/surface"},
        {"$ref": "#/$defs/action"},
        {"$ref": "#/$defs/assertion"}
      ]
    },
    "advance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "milliseconds"],
      "properties": {
        "op": {"const": "clock.advance"},
        "milliseconds": {"type": "integer", "minimum": 0}
      }
    },
    "set_wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "wall_time_ms"],
      "properties": {
        "op": {"const": "clock.set_wall"},
        "wall_time_ms": {"type": "integer"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {"const": "lifecycle.set"},
        "app_state": {
          "enum": ["stopped", "foreground", "background", "suspended", "crashed"]
        },
        "display_state": {"enum": ["awake", "asleep"]},
        "connectivity": {"enum": ["online", "degraded", "offline"]}
      },
      "anyOf": [
        {"required": ["app_state"]},
        {"required": ["display_state"]},
        {"required": ["connectivity"]}
      ]
    },
    "reboot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "downtime_ms"],
      "properties": {
        "op": {"const": "system.reboot"},
        "downtime_ms": {"type": "integer", "minimum": 0}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "provider", "event", "revision", "status", "payload"],
      "properties": {
        "op": {"const": "provider.emit"},
        "provider": {"$ref": "#/$defs/id"},
        "event": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 0},
        "status": {"enum": ["current", "stale", "offline", "error"]},
        "payload": {"type": "object"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "snapshot"],
      "properties": {
        "op": {"const": "surface.publish"},
        "snapshot": {
          "$ref": "surface-state-v1.schema.json"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target"],
      "properties": {
        "op": {"const": "action.dispatch"},
        "target": {"$ref": "#/$defs/id"},
        "value": {}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "equals"],
      "properties": {
        "op": {"const": "assert.state"},
        "equals": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      }
    }
  }
}
