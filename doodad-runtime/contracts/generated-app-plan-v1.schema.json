{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doodad.dev/schemas/generated-app-plan-v1.schema.json",
  "title": "Doodad generated app plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_summary",
    "app_id",
    "name",
    "version",
    "identity",
    "capabilities",
    "interactions",
    "scenarios"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "product_summary": {"type": "string", "minLength": 1, "maxLength": 320},
    "app_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$", "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 48},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "identity": {"$ref": "manifest-v1.schema.json#/$defs/identity"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "required_ops"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"},
          "kind": {"enum": ["interaction", "timer", "provider"]},
          "required_ops": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"enum": ["action.dispatch", "assert.state", "clock.advance", "provider.emit", "lifecycle.set"]}
          }
        }
      }
    }
  }
}
