{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doodad.dev/schemas/manifest-v1.schema.json",
  "title": "Doodad application manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "host_abi",
    "identity",
    "capabilities",
    "wasm"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "host_abi": {
      "type": "integer",
      "minimum": 1
    },
    "identity": {"$ref": "#/$defs/identity"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
      }
    },
    "wasm": {
      "const": "app.wasm"
    },
    "ui": {
      "const": "ui.json"
    },
    "assets": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "path",
          "media_type",
          "width",
          "height",
          "encoded_bytes",
          "decoded_bytes"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "pattern": "^assets/[0-9a-f]{64}\\.dimg$"
          },
          "media_type": {
            "const": "image/vnd.doodad.rgb565le"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "encoded_bytes": {
            "type": "integer",
            "minimum": 14,
            "maximum": 524288
          },
          "decoded_bytes": {
            "type": "integer",
            "minimum": 2,
            "maximum": 524288
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "theme_seed"],
      "properties": {
        "icon": {"enum": ["generic", "timer", "weather", "tasks", "calculator", "calendar", "water_drop"]},
        "theme_seed": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}
      }
    }
  }
}
