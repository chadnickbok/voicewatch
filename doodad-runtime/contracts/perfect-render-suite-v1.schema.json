{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doodad.dev/schemas/perfect-render-suite-v1.schema.json",
  "title": "Doodad Perfect Render suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "version"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_slug",
        "trace",
        "sequence",
        "snapshot_sha256",
        "capture_phase",
        "profile_id",
        "compose",
        "lvgl",
        "comparison_policy",
        "review"
      ],
      "properties": {
        "app_slug": {
          "$ref": "#/$defs/id"
        },
        "trace": {
          "$ref": "#/$defs/safe_path"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capture_phase": {
          "$ref": "#/$defs/id"
        },
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "compose": {
          "allOf": [
            {
              "$ref": "#/$defs/renderer"
            },
            {
              "properties": {
                "mode": {
                  "enum": [
                    "host",
                    "emulator"
                  ]
                }
              }
            }
          ]
        },
        "lvgl": {
          "allOf": [
            {
              "$ref": "#/$defs/renderer"
            },
            {
              "properties": {
                "mode": {
                  "enum": [
                    "simulator",
                    "hardware"
                  ]
                }
              }
            }
          ]
        },
        "comparison_policy": {
          "$ref": "#/$defs/id"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    }
  }
}
