{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doodad.dev/schemas/scene-snapshot-v1.schema.json",
  "title": "Doodad resolved scene snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "screen_id",
    "origin",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "app_id": {
      "$ref": "#/$defs/id"
    },
    "screen_id": {
      "$ref": "#/$defs/id"
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "origin": {
      "enum": [
        "guest_appspec",
        "trusted_surface",
        "hybrid_projection"
      ]
    },
    "kind": {
      "enum": [
        "screen",
        "column",
        "row",
        "scroll",
        "text",
        "button",
        "card",
        "progress",
        "stepper",
        "toggle",
        "keypad",
        "voice_orb",
        "live_card",
        "image"
      ]
    },
    "role": {
      "enum": [
        "screen",
        "heading",
        "text",
        "button",
        "toggle",
        "progress",
        "list",
        "list_item",
        "dialog",
        "slider",
        "group",
        "image"
      ]
    },
    "event_kind": {
      "enum": [
        "tap",
        "long_press",
        "repeat",
        "value_changing",
        "value_committed",
        "checked_changed",
        "page_changed",
        "dismissed",
        "submit",
        "retry",
        "cancel"
      ]
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_text": {
          "type": "string",
          "maxLength": 256
        },
        "secondary_text": {
          "type": "string",
          "maxLength": 256
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "alignment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": "integer"
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "step": {
          "type": "integer"
        },
        "checked": {
          "type": "boolean"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4
          }
        },
        "key_columns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "label"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "maxLength": 128
        },
        "hint": {
          "type": "string",
          "maxLength": 128
        },
        "state_description": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "action_id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/event_kind"
        },
        "action_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_id",
        "kind",
        "depth",
        "child_count",
        "visible",
        "enabled",
        "props",
        "semantics",
        "actions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parent_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "child_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "visible": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "props": {
          "$ref": "#/$defs/props"
        },
        "semantics": {
          "$ref": "#/$defs/semantics"
        },
        "actions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    }
  }
}
