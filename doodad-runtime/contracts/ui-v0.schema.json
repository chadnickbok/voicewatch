{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doodad.dev/schemas/ui-v0.schema.json",
  "title": "Doodad declarative UI v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root"
  ],
  "properties": {
    "schema_version": {
      "const": 0
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/stack"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/button"
        },
        {
          "$ref": "#/$defs/progress"
        }
      ]
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "children"
      ],
      "properties": {
        "type": {
          "const": "stack"
        },
        "direction": {
          "enum": [
            "column",
            "row"
          ],
          "default": "column"
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "default": "center"
        },
        "gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32,
          "default": 8
        },
        "children": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "maxLength": 256
        },
        "style": {
          "enum": [
            "display",
            "title",
            "body",
            "caption",
            "muted"
          ],
          "default": "body"
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "label"
      ],
      "properties": {
        "type": {
          "const": "button"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "disabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value",
        "maximum"
      ],
      "properties": {
        "type": {
          "const": "progress"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  }
}
