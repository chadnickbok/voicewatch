# Full portrait shell bring-up. Voice transport cutover is a subsequent gate;
# this board profile must not silently start the legacy WebRTC transport.
# CONFIG_DOODAD_BOARD_CORES3 is not set
# CONFIG_DOODAD_BOARD_TWATCH_S3 is not set
CONFIG_DOODAD_BOARD_TWATCH_ULTRA=y
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/t-watch-ultra/partitions.csv"
# Authenticated bootstrap sets UTC before HTTPS/WSS; always check validity dates.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# CONFIG_DOODAD_VOICE_UPLINK is not set
