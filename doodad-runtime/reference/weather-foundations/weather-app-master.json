                    {
                      "id": "weather.daily-dots", "type": "row",
                      "props": {"gap": "xs", "align": "center", "children": [
                        {"id": "weather.daily-dot-current", "type": "surface", "props": {"tone": "neutral", "shape": "pill", "gap": "none", "align": "center", "children": []}},
                        {"id": "weather.daily-dot-hourly", "type": "surface", "props": {"tone": "neutral", "shape": "pill", "gap": "none", "align": "center", "children": []}},
                        {"id": "weather.daily-dot-selected", "type": "surface", "props": {"tone": "primary", "shape": "pill", "gap": "none", "align": "center", "children": []}},
                        {"id": "weather.daily-dot-details", "type": "surface", "props": {"tone": "neutral", "shape": "pill", "gap": "none", "align": "center", "children": []}}
