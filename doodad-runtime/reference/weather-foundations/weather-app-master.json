{
  "schema_version": 1,
  "app_id": "weather",
  "screen": {
    "id": "weather.home",
    "type": "screen",
    "props": {
      "gap": "none",
      "align": "stretch",
      "children": [
        {
          "id": "weather.pages",
          "type": "pager",
          "props": {
            "selected": 0,
            "show_indicator": false,
            "gap": "none",
            "align": "stretch",
            "children": [
              {
