                                {"id": "weather.hourly-time-20", "type": "text", "props": {"text": "20m", "style": "caption", "max_lines": 1, "align": "center"}},
                                {"id": "weather.hourly-time-40", "type": "text", "props": {"text": "40m", "style": "caption", "max_lines": 1, "align": "center"}},
                                {"id": "weather.hourly-time-60", "type": "text", "props": {"text": "60m", "style": "caption", "max_lines": 1, "align": "end"}}
