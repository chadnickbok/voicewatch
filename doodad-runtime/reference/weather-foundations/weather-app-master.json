                      }
                    },
                    {
                      "id": "weather.hourly-status-chip",
                      "type": "surface",
                      "props": {
                        "tone": "secondary", "shape": "pill", "gap": "none", "align": "center",
                        "children": [
                          {"id": "weather.hourly-status", "type": "text", "props": {"text": "Now", "style": "caption", "max_lines": 1, "align": "center"}, "semantics": {"label": "Weather updated now"}}
                        ]
                      }
                    },
                    {
                      "id": "weather.hourly-chart-card",
                      "type": "surface",
                      "props": {
                        "tone": "secondary", "shape": "standard", "gap": "none", "align": "stretch",
                        "children": [
                          {
                            "id": "weather.hourly-chart-heading",
                            "type": "row",
                            "props": {
                              "gap": "xs", "align": "start",
                              "children": [
                                {"id": "weather.hourly-rain-icon", "type": "icon", "props": {"name": "utility_humidity", "tone": "primary", "size": "compact"}, "semantics": {"label": "Precipitation"}},
                                {"id": "weather.hourly-rain-label", "type": "text", "props": {"text": "Rain", "style": "caption", "max_lines": 1, "align": "start"}},
                                {"id": "weather.hourly-rain-value", "type": "text", "props": {"text": "0%", "style": "label", "max_lines": 1, "align": "end"}}
                              ]
                            }
                          },
                          {
                            "id": "weather.rain-chart",
                            "type": "chart",
                            "props": {"samples": [0, 0, 0, 0], "maximum": 100, "style": "line", "tone": "primary"},
                            "semantics": {"label": "Rain chance remains at zero percent for the next hour"}
                          },
                          {
                            "id": "weather.hourly-times",
