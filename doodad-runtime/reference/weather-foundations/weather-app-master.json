                "type": "column",
                "props": {
                  "gap": "xs",
                  "align": "stretch",
                  "children": [
                    {
                      "id": "weather.location-row",
                      "type": "row",
                      "props": {
                        "gap": "xs",
                        "align": "start",
                        "children": [
                          {
                            "id": "weather.location-icon",
                            "type": "icon",
                            "props": {"name": "utility_location", "tone": "neutral", "size": "compact"},
                            "semantics": {"label": "Location"}
                          },
                          {
                            "id": "weather.location",
                            "type": "text",
                            "props": {"text": "San Francisco", "style": "caption", "max_lines": 1, "align": "start"}
                          }
                        ]
                      }
                    },
                    {
                      "id": "weather.hero-row",
                      "type": "row",
                      "props": {
                        "gap": "xs",
                        "align": "stretch",
                        "children": [
                          {
                            "id": "weather.summary",
                            "type": "text",
                            "props": {"text": "62°", "style": "numeral", "max_lines": 1, "align": "start"},
                            "semantics": {"label": "Current temperature", "value": "62 degrees"}
                          },
                          {
                            "id": "weather.condition-icon",
                            "type": "icon",
                            "props": {"name": "condition_partly_cloudy_day", "tone": "tertiary", "size": "hero"},
                            "semantics": {"label": "Partly cloudy"}
                          }
                        ]
                      }
                    },
                    {
                      "id": "weather.symbol",
                      "type": "text",
                      "props": {"text": "Partly cloudy", "style": "body", "max_lines": 1, "align": "start"},
                      "semantics": {"label": "Condition", "value": "Partly cloudy"}
                    },
                    {
                      "id": "weather.high-low",
                      "type": "row",
                      "props": {
                        "gap": "xs",
                        "align": "stretch",
                        "children": [
                          {
                            "id": "weather.high-pill",
                            "type": "surface",
                            "props": {
                              "tone": "secondary", "shape": "pill", "gap": "none", "align": "center",
                              "children": [
                                {
                                  "id": "weather.high-row",
