                            ]}
                          },
                          {
                            "id": "weather.hour-10-tile", "type": "surface",
                            "props": {"tone": "neutral", "shape": "standard", "gap": "none", "align": "center", "children": [
                              {"id": "weather.hour-10", "type": "column", "props": {"gap": "none", "align": "center", "children": [
                                {"id": "weather.hour-10-label", "type": "text", "props": {"text": "10", "style": "caption", "max_lines": 1, "align": "center"}},
                                {"id": "weather.hour-10-icon", "type": "icon", "props": {"name": "condition_partly_cloudy_day", "tone": "tertiary", "size": "compact"}, "semantics": {"label": "Partly cloudy"}},
                                {"id": "weather.hour-10-temp", "type": "text", "props": {"text": "63°", "style": "body", "max_lines": 1, "align": "center"}}
                              ]}}
                            ]}
                          },
                          {
                            "id": "weather.hour-11-tile", "type": "surface",
                            "props": {"tone": "neutral", "shape": "standard", "gap": "none", "align": "center", "children": [
                              {"id": "weather.hour-11", "type": "column", "props": {"gap": "none", "align": "center", "children": [
                                {"id": "weather.hour-11-label", "type": "text", "props": {"text": "11", "style": "caption", "max_lines": 1, "align": "center"}},
                                {"id": "weather.hour-11-icon", "type": "icon", "props": {"name": "condition_clear_day", "tone": "tertiary", "size": "compact"}, "semantics": {"label": "Sunny"}},
                                {"id": "weather.hour-11-temp", "type": "text", "props": {"text": "65°", "style": "body", "max_lines": 1, "align": "center"}}
                              ]}}
                            ]}
                          },
                          {
                            "id": "weather.hour-12-tile", "type": "surface",
                            "props": {"tone": "neutral", "shape": "standard", "gap": "none", "align": "center", "children": [
                              {"id": "weather.hour-12", "type": "column", "props": {"gap": "none", "align": "center", "children": [
                                {"id": "weather.hour-12-label", "type": "text", "props": {"text": "12", "style": "caption", "max_lines": 1, "align": "center"}},
                                {"id": "weather.hour-12-icon", "type": "icon", "props": {"name": "condition_clear_day", "tone": "tertiary", "size": "compact"}, "semantics": {"label": "Sunny"}},
                                {"id": "weather.hour-12-temp", "type": "text", "props": {"text": "66°", "style": "body", "max_lines": 1, "align": "center"}}
                              ]}}
                            ]}
                          }
                        ]
