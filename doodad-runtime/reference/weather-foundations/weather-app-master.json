                                  "props": {
                                    "gap": "xs", "align": "center",
                                    "children": [
                                      {"id": "weather.high-icon", "type": "icon", "props": {"name": "utility_arrow_high", "tone": "tertiary", "size": "compact"}, "semantics": {"label": "High temperature"}},
                                      {"id": "weather.high", "type": "text", "props": {"text": "H 67°", "style": "label", "max_lines": 1, "align": "center"}}
                                    ]
                                  }
                                }
                              ]
                            }
                          },
                          {
                            "id": "weather.low-pill",
                            "type": "surface",
                            "props": {
                              "tone": "secondary", "shape": "pill", "gap": "none", "align": "center",
                              "children": [
                                {
                                  "id": "weather.low-row",
                                  "type": "row",
                                  "props": {
                                    "gap": "xs", "align": "center",
                                    "children": [
                                      {"id": "weather.low-icon", "type": "icon", "props": {"name": "utility_arrow_low", "tone": "primary", "size": "compact"}, "semantics": {"label": "Low temperature"}},
                                      {"id": "weather.low", "type": "text", "props": {"text": "L 54°", "style": "label", "max_lines": 1, "align": "center"}}
                                    ]
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "weather.feels-pill",
                      "type": "surface",
                      "props": {
                        "tone": "secondary", "shape": "pill", "gap": "none", "align": "start",
                        "children": [
                          {
                            "id": "weather.feels-row",
                            "type": "row",
                            "props": {
                              "gap": "xs", "align": "start",
                              "children": [
                                {"id": "weather.feels-icon", "type": "icon", "props": {"name": "utility_thermometer", "tone": "neutral", "size": "compact"}, "semantics": {"label": "Feels like"}},
                                {"id": "weather.feels-label", "type": "text", "props": {"text": "Feels like", "style": "caption", "max_lines": 1, "align": "start"}},
                                {"id": "weather.feels", "type": "text", "props": {"text": "59°", "style": "label", "max_lines": 1, "align": "end"}}
