                              {"id": "weather.day-tue-low", "type": "text", "props": {"text": "51°", "style": "label", "max_lines": 1, "align": "end"}},
                              {"id": "weather.day-tue-high", "type": "text", "props": {"text": "63°", "style": "body", "max_lines": 1, "align": "end"}}
