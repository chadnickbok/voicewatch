                      }
                    },
                    {
                      "id": "weather.status-chip",
                      "type": "surface",
                      "props": {
                        "tone": "secondary", "shape": "pill", "gap": "none", "align": "center",
                        "children": [
                          {
                            "id": "weather.status-row",
                            "type": "row",
                            "props": {
                              "gap": "xs", "align": "center",
                              "children": [
                                {"id": "weather.status", "type": "text", "props": {"text": "Now", "style": "caption", "max_lines": 1, "align": "center"}, "semantics": {"label": "Weather updated now"}}
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "id": "weather.primary",
                      "type": "button",
                      "props": {"label": "Hourly", "icon": "utility_chevron_right", "tone": "primary", "variant": "filled", "size": "compact"},
                      "events": {"tap": "weather.hourly"},
                      "semantics": {"label": "Show hourly forecast"}
                    }
                  ]
                }
              },
              {
                "id": "weather.hourly",
                "type": "column",
                "props": {
                  "gap": "none",
                  "align": "stretch",
                  "children": [
                    {
                      "id": "weather.hourly-summary",
