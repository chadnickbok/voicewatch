                              {"id": "weather.day-wed-low", "type": "text", "props": {"text": "52°", "style": "label", "max_lines": 1, "align": "end"}},
                              {"id": "weather.day-wed-high", "type": "text", "props": {"text": "64°", "style": "body", "max_lines": 1, "align": "end"}}
