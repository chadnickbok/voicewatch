                              {"id": "weather.day-today-high", "type": "text", "props": {"text": "67°", "style": "body", "max_lines": 1, "align": "end"}}
                            ]}}
                          ]}
                        },
                        {
                          "id": "weather.day-mon-tile", "type": "surface",
                          "props": {"tone": "neutral", "shape": "standard", "gap": "none", "align": "stretch", "children": [
                            {"id": "weather.day-mon", "type": "row", "props": {"gap": "none", "align": "stretch", "children": [
                              {"id": "weather.day-mon-label", "type": "text", "props": {"text": "MON", "style": "label", "max_lines": 1, "align": "start"}},
                              {"id": "weather.day-mon-icon", "type": "icon", "props": {"name": "condition_partly_cloudy_day", "tone": "tertiary", "size": "large"}, "semantics": {"label": "Partly cloudy"}},
                              {"id": "weather.day-mon-low", "type": "text", "props": {"text": "53°", "style": "label", "max_lines": 1, "align": "end"}},
                              {"id": "weather.day-mon-high", "type": "text", "props": {"text": "65°", "style": "body", "max_lines": 1, "align": "end"}}
