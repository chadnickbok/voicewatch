                      "props": {
                        "gap": "xs", "align": "start",
                        "children": [
                          {"id": "weather.hourly-condition-icon", "type": "icon", "props": {"name": "condition_partly_cloudy_day", "tone": "tertiary", "size": "large"}, "semantics": {"label": "Partly cloudy"}},
                          {
                            "id": "weather.hourly-summary-copy",
                            "type": "column",
                            "props": {
                              "gap": "none", "align": "start",
                              "children": [
                                {"id": "weather.hourly-now", "type": "text", "props": {"text": "Now 62°", "style": "body", "max_lines": 1, "align": "start"}, "semantics": {"label": "Current temperature", "value": "62 degrees"}},
                                {"id": "weather.hourly-condition", "type": "text", "props": {"text": "Partly cloudy", "style": "caption", "max_lines": 1, "align": "start"}}
                              ]
                            }
                          }
